  "sentences": [
    {
      "id": "s01",
      "text": "A que horas a loja abre?",
      "de": "Um wie viel Uhr öffnet der Laden?",
      "words": [
        "loja",
        "hora"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s02",
      "text": "O supermercado está aberto no domingo?",
      "de": "Ist der Supermarkt am Sonntag geöffnet?",
      "words": [
        "supermercado",
        "aberto"
      ]
    },
    {
      "id": "s03",
      "text": "A loja já está fechada.",
      "de": "Der Laden ist schon geschlossen.",
      "words": [
        "loja",
        "fechado"
      ]
    },
    {
      "id": "s04",
      "text": "Vamos à feira no sábado?",
      "de": "Gehen wir am Samstag auf den Markt?",
      "words": [
        "feira",
        "ir"
      ],
      "grammar": [
        "ir_futuro",
        "praep_artikel"
      ]
    },
    {
      "id": "s05",
      "text": "Na feira as frutas são mais baratas.",
      "de": "Auf dem Markt ist das Obst günstiger.",
      "words": [
        "feira",
        "mais",
        "barato"
      ],
      "grammar": [
        "vergleich",
        "praep_artikel"
      ]
    },
    {
      "id": "s06",
      "text": "Eu compro pão na padaria.",
      "de": "Ich kaufe Brot in der Bäckerei.",
      "words": [
        "eu",
        "comprar",
        "pao",
        "padaria"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s07",
      "text": "Meio quilo de carne moída, por favor.",
      "de": "Ein halbes Kilo Hackfleisch, bitte.",
      "words": [
        "quilo",
        "carne",
        "por_favor"
      ]
    },
    {
      "id": "s08",
      "text": "O açougue fica ao lado do mercado.",
      "de": "Die Metzgerei ist neben dem Markt.",
      "words": [
        "acougue",
        "mercado",
        "ao_lado",
        "ficar"
      ]
    },
    {
      "id": "s09",
      "text": "Vamos ao shopping comprar roupa.",
      "de": "Wir gehen ins Einkaufszentrum, Kleider kaufen.",
      "words": [
        "shopping",
        "comprar",
        "roupa",
        "ir"
      ],
      "grammar": [
        "ir_futuro"
      ]
    },
    {
      "id": "s10",
      "text": "Onde fica o caixa?",
      "de": "Wo ist die Kasse?",
      "words": [
        "onde",
        "caixa",
        "ficar"
      ]
    },
    {
      "id": "s11",
      "text": "Quer uma sacola?",
      "de": "Möchten Sie eine Tüte?",
      "words": [
        "sacola"
      ]
    },
    {
      "id": "s12",
      "text": "Só estou olhando, obrigado.",
      "de": "Ich schaue nur, danke.",
      "words": [
        "olhar",
        "obrigado"
      ]
    },
    {
      "id": "s13",
      "text": "Estou procurando uma camiseta branca.",
      "de": "Ich suche ein weisses T-Shirt.",
      "words": [
        "procurar",
        "camiseta",
        "branco"
      ],
      "grammar": [
        "adjektive"
      ]
    },
    {
      "id": "s14",
      "text": "Posso experimentar essa calça?",
      "de": "Kann ich diese Hose anprobieren?",
      "words": [
        "experimentar",
        "esse",
        "calca"
      ],
      "grammar": [
        "demonstrativ"
      ]
    },
    {
      "id": "s15",
      "text": "Onde fica o provador?",
      "de": "Wo ist die Umkleidekabine?",
      "words": [
        "onde",
        "provador",
        "ficar"
      ]
    },
    {
      "id": "s16",
      "text": "Qual é o seu tamanho?",
      "de": "Welche Grösse haben Sie?",
      "words": [
        "qual",
        "tamanho"
      ]
    },
    {
      "id": "s17",
      "text": "Tem um tamanho maior?",
      "de": "Gibt es das eine Grösse grösser?",
      "words": [
        "tamanho"
      ],
      "grammar": [
        "vergleich"
      ]
    },
    {
      "id": "s18",
      "text": "Essa camisa é pequena demais.",
      "de": "Dieses Hemd ist zu klein.",
      "words": [
        "esse",
        "camisa",
        "pequeno"
      ],
      "grammar": [
        "demonstrativ"
      ]
    },
    {
      "id": "s19",
      "text": "Tem em outra cor?",
      "de": "Gibt es das in einer anderen Farbe?",
      "words": [
        "cor",
        "outro"
      ]
    },
    {
      "id": "s20",
      "text": "Eu gosto desse vestido vermelho.",
      "de": "Mir gefällt dieses rote Kleid.",
      "words": [
        "eu",
        "vestido",
        "vermelho"
      ],
      "grammar": [
        "adjektive",
        "demonstrativ"
      ]
    },
    {
      "id": "s21",
      "text": "A saia azul é mais bonita.",
      "de": "Der blaue Rock ist schöner.",
      "words": [
        "saia",
        "azul",
        "mais"
      ],
      "grammar": [
        "vergleich",
        "adjektive"
      ]
    },
    {
      "id": "s22",
      "text": "Esse casaco preto custa quanto?",
      "de": "Wie viel kostet diese schwarze Jacke?",
      "words": [
        "esse",
        "casaco",
        "preto"
      ],
