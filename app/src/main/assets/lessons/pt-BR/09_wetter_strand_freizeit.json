  "sentences": [
    {
      "id": "s01",
      "text": "Como está o tempo hoje?",
      "de": "Wie ist das Wetter heute?",
      "words": [
        "como",
        "tempo",
        "hoje"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s02",
      "text": "Hoje faz sol e muito calor.",
      "de": "Heute scheint die Sonne und es ist sehr heiss.",
      "words": [
        "hoje",
        "sol",
        "calor",
        "muito"
      ],
      "grammar": [
        "wetter"
      ]
    },
    {
      "id": "s03",
      "text": "Está chovendo desde hoje de manhã.",
      "de": "Es regnet seit heute Morgen.",
      "words": [
        "chover",
        "hoje"
      ],
      "grammar": [
        "wetter"
      ]
    },
    {
      "id": "s04",
      "text": "Vai chover amanhã?",
      "de": "Wird es morgen regnen?",
      "words": [
        "chover",
        "amanha",
        "ir"
      ],
      "grammar": [
        "ir_futuro",
        "wetter"
      ]
    },
    {
      "id": "s05",
      "text": "Leve um guarda-chuva, vai ter chuva.",
      "de": "Nimm einen Regenschirm mit, es wird Regen geben.",
      "words": [
        "chuva",
        "levar"
      ],
      "grammar": [
        "ir_futuro"
      ]
    },
    {
      "id": "s06",
      "text": "Hoje está nublado e úmido.",
      "de": "Heute ist es bewölkt und schwül.",
      "words": [
        "hoje",
        "nublado",
        "umido"
      ],
      "grammar": [
        "wetter"
      ]
    },
    {
      "id": "s07",
      "text": "Tem uma nuvem preta no céu.",
      "de": "Am Himmel ist eine schwarze Wolke.",
      "words": [
        "nuvem",
        "preto"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s08",
      "text": "Está ventando muito na praia.",
      "de": "Am Strand ist es sehr windig.",
      "words": [
        "muito",
        "praia"
      ],
      "grammar": [
        "wetter"
      ]
    },
    {
      "id": "s09",
      "text": "O vento está forte hoje.",
      "de": "Der Wind ist heute stark.",
      "words": [
        "vento",
        "hoje"
      ]
    },
    {
      "id": "s10",
      "text": "Qual é a temperatura agora?",
      "de": "Wie viel Grad hat es jetzt?",
      "words": [
        "qual",
        "temperatura"
      ]
    },
    {
      "id": "s11",
      "text": "Está fazendo trinta e cinco graus!",
      "de": "Es hat fünfunddreissig Grad!",
      "words": [
        "num_30",
        "num_5",
        "grau"
      ],
      "grammar": [
        "wetter"
      ]
    },
    {
      "id": "s12",
      "text": "No inverno faz frio no sul do Brasil.",
      "de": "Im Winter ist es im Süden Brasiliens kalt.",
      "words": [
        "frio",
        "brasil"
      ],
      "grammar": [
        "wetter",
        "praep_artikel"
      ]
    },
    {
      "id": "s13",
      "text": "Cuidado, vem uma tempestade.",
      "de": "Vorsicht, ein Gewitter kommt.",
      "words": [
        "tempestade",
        "vir"
      ]
    },
    {
      "id": "s14",
      "text": "Vamos à praia hoje?",
      "de": "Gehen wir heute an den Strand?",
      "words": [
        "praia",
        "hoje",
        "ir"
      ],
      "grammar": [
        "ir_futuro",
        "praep_artikel"
      ]
    },
    {
      "id": "s15",
      "text": "A água do mar está quente.",
      "de": "Das Meerwasser ist warm.",
      "words": [
        "agua",
        "mar",
        "quente"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s16",
      "text": "A areia está muito quente.",
      "de": "Der Sand ist sehr heiss.",
      "words": [
        "areia",
        "muito",
        "quente"
      ]
    },
    {
      "id": "s17",
      "text": "As ondas estão grandes hoje.",
      "de": "Die Wellen sind heute hoch.",
      "words": [
        "onda",
        "grande",
        "hoje"
      ]
    },
    {
      "id": "s18",
      "text": "É perigoso nadar aqui?",
      "de": "Ist es gefährlich, hier zu schwimmen?",
      "words": [
        "perigoso",
        "nadar",
        "aqui"
      ]
    },
    {
      "id": "s19",
      "text": "Eu nado todo dia de manhã.",
      "de": "Ich schwimme jeden Morgen.",
      "words": [
        "eu",
        "nadar"
      ],
      "grammar": [
        "praesens"
      ]
    },
    {
      "id": "s20",
      "text": "Nade perto do salva-vidas.",
      "de": "Schwimm in der Nähe des Rettungsschwimmers.",
      "words": [
        "nadar",
        "perto",
        "salva_vidas"
      ],
      "grammar": [
        "anweisungen"
      ]
    },
    {
      "id": "s21",
      "text": "Quanto custa alugar um guarda-sol e duas cadeiras de praia?",
      "de": "Was kostet es, einen Sonnenschirm und zwei Strandstühle zu mieten?",
      "words": [
        "alugar",
        "guarda_sol",
        "cadeira_praia",
        "num_2"
      ]
    },
    {
      "id": "s22",
      "text": "Esqueci a minha canga no hotel.",
      "de": "Ich habe mein Strandtuch im Hotel vergessen.",
      "words": [
        "canga",
        "hotel"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s23",
      "text": "Você sabe surfar?",
      "de": "Kannst du surfen?",
      "words": [
        "voce",
        "surfar"
      ]
    },
    {
      "id": "s24",
      "text": "Eles surfam muito bem.",
      "de": "Sie surfen sehr gut.",
      "words": [
        "eles",
        "muito",
        "bem"
      ],
      "grammar": [
        "praesens"
      ]
    },
    {
      "id": "s25",
      "text": "Vamos mergulhar perto da ilha.",
      "de": "Wir gehen in der Nähe der Insel tauchen.",
      "words": [
        "mergulhar",
        "perto",
        "ilha",
        "ir"
      ],
      "grammar": [
        "ir_futuro"
      ]
    },
    {
      "id": "s26",
      "text": "O passeio de barco sai às nove.",
      "de": "Der Bootsausflug fährt um neun ab.",
      "words": [
        "passeio",
        "barco",
        "num_9",
        "sair"
      ]
    },
    {
      "id": "s27",
      "text": "Vamos fazer uma trilha na montanha.",
      "de": "Wir machen eine Wanderung in den Bergen.",
      "words": [
        "fazer",
        "trilha",
        "montanha",
        "ir"
      ],
      "grammar": [
        "ir_futuro"
      ]
    },
    {
      "id": "s28",
      "text": "A trilha até a cachoeira leva duas horas.",
      "de": "Der Weg zum Wasserfall dauert zwei Stunden.",
      "words": [
        "trilha",
        "cachoeira",
        "levar",
        "num_2",
        "hora"
      ]
    },
    {
      "id": "s29",
      "text": "O rio é muito bonito e limpo.",
      "de": "Der Fluss ist sehr schön und sauber.",
      "words": [
        "rio",
        "muito",
        "bonito",
        "limpo"
      ]
    },
    {
      "id": "s30",
      "text": "Dá para nadar no lago?",
      "de": "Kann man im See schwimmen?",
      "words": [
        "nadar",
        "lago"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s31",
      "text": "A floresta é cheia de animais.",
      "de": "Der Wald ist voller Tiere.",
      "words": [
        "floresta"
      ]
    },
    {
      "id": "s32",
      "text": "A gente vai ver o pôr do sol na praia.",
      "de": "Wir schauen uns den Sonnenuntergang am Strand an.",
      "words": [
        "a_gente",
        "por_do_sol",
        "praia",
        "ir"
      ],
      "grammar": [
        "a_gente",
        "ir_futuro"
      ]
    },
    {
      "id": "s33",
      "text": "O parque fecha às seis.",
      "de": "Der Park schliesst um sechs.",
      "words": [
        "parque",
        "fechar",
        "num_6"
      ],
      "grammar": [
        "praesens"
      ]
    },
    {
      "id": "s34",
      "text": "O museu abre às dez.",
      "de": "Das Museum öffnet um zehn.",
      "words": [
        "museu",
        "abrir",
        "num_10"
      ],
      "grammar": [
        "praesens"
      ]
    },
    {
      "id": "s35",
      "text": "Tem show de samba hoje à noite.",
      "de": "Heute Abend gibt es ein Samba-Konzert.",
      "words": [
        "show",
        "samba",
        "hoje",
        "noite"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s36",
      "text": "Onde eu compro ingressos?",
      "de": "Wo kaufe ich Eintrittskarten?",
      "words": [
        "onde",
        "eu",
        "comprar",
        "ingresso"
      ],
      "grammar": [
        "praesens"
      ]
    },
    {
      "id": "s37",
      "text": "Dois ingressos para o show, por favor.",
      "de": "Zwei Karten für das Konzert, bitte.",
      "words": [
        "num_2",
        "ingresso",
        "show",
        "por_favor"
      ]
    },
    {
      "id": "s38",
      "text": "Vamos ao cinema ou ao teatro?",
      "de": "Gehen wir ins Kino oder ins Theater?",
      "words": [
        "cinema",
        "teatro",
        "ir"
      ],
      "grammar": [
        "ir_futuro",
        "praep_artikel"
      ]
    },
    {
      "id": "s39",
      "text": "Sábado tem uma festa na casa dele.",
      "de": "Am Samstag ist eine Party bei ihm.",
      "words": [
        "festa"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s40",
      "text": "O carnaval é em fevereiro.",
      "de": "Der Karneval ist im Februar.",
      "words": [
        "carnaval"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s41",
      "text": "Você dança samba?",
      "de": "Tanzt du Samba?",
      "words": [
        "voce",
        "dancar",
        "samba"
      ],
      "grammar": [
        "praesens"
      ]
    },
    {
      "id": "s42",
      "text": "Eu danço muito mal!",
      "de": "Ich tanze sehr schlecht!",
      "words": [
        "eu",
        "dancar",
