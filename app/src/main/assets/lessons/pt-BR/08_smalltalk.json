  "sentences": [
    {
      "id": "s01",
      "text": "De onde você é?",
      "de": "Woher kommst du?",
      "words": [
        "de_onde",
        "voce"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s02",
      "text": "Eu sou da Alemanha.",
      "de": "Ich komme aus Deutschland.",
      "words": [
        "eu",
        "alemanha"
      ],
      "grammar": [
        "ser_estar",
        "praep_artikel"
      ]
    },
    {
      "id": "s03",
      "text": "Sou suíço, de Zurique.",
      "de": "Ich bin Schweizer, aus Zürich.",
      "words": [
        "suico"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s04",
      "text": "Ela é austríaca.",
      "de": "Sie ist Österreicherin.",
      "words": [
        "ela",
        "austriaco"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s05",
      "text": "Ele é brasileiro, de Salvador.",
      "de": "Er ist Brasilianer, aus Salvador.",
      "words": [
        "ele",
        "brasileiro"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s06",
      "text": "A Suíça é um país pequeno.",
      "de": "Die Schweiz ist ein kleines Land.",
      "words": [
        "suica",
        "pais_land",
        "pequeno"
      ]
    },
    {
      "id": "s07",
      "text": "O Brasil é muito grande.",
      "de": "Brasilien ist sehr gross.",
      "words": [
        "brasil",
        "muito",
        "grande"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s08",
      "text": "Faz tempo que você mora no Brasil?",
      "de": "Wohnst du schon lange in Brasilien?",
      "words": [
        "voce",
        "morar",
        "brasil"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s09",
      "text": "Eu moro numa cidade pequena perto de Munique.",
      "de": "Ich wohne in einer kleinen Stadt bei München.",
      "words": [
        "eu",
        "morar",
        "cidade",
        "pequeno",
        "perto"
      ]
    },
    {
      "id": "s10",
      "text": "É a primeira vez que você vem ao Brasil?",
      "de": "Bist du zum ersten Mal in Brasilien?",
      "words": [
        "voce",
        "vir",
        "brasil"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s11",
      "text": "Muitos estrangeiros moram aqui.",
      "de": "Hier wohnen viele Ausländer.",
      "words": [
        "estrangeiro",
        "morar",
        "aqui"
      ]
    },
    {
      "id": "s12",
      "text": "Você é casado?",
      "de": "Bist du verheiratet?",
      "words": [
        "voce",
        "casado"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s13",
      "text": "Não, sou solteiro.",
      "de": "Nein, ich bin ledig.",
      "words": [
        "nao",
        "solteiro"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s14",
      "text": "Esta é a minha esposa, Maria.",
      "de": "Das ist meine Frau, Maria.",
      "words": [
        "esposa",
        "este"
      ],
      "grammar": [
        "possessiv",
        "demonstrativ"
      ]
    },
    {
      "id": "s15",
      "text": "Este é o meu marido.",
      "de": "Das ist mein Mann.",
      "words": [
        "marido",
        "este"
      ],
      "grammar": [
        "possessiv",
        "demonstrativ"
      ]
    },
    {
      "id": "s16",
      "text": "Você tem filhos?",
      "de": "Hast du Kinder?",
      "words": [
        "voce",
        "filho",
        "ter"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s17",
      "text": "Tenho um filho e uma filha.",
      "de": "Ich habe einen Sohn und eine Tochter.",
      "words": [
        "filho",
        "filha",
        "ter"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s18",
      "text": "Meus pais moram na Áustria.",
      "de": "Meine Eltern wohnen in Österreich.",
      "words": [
        "pais_eltern",
        "morar",
        "austria"
      ],
      "grammar": [
        "possessiv",
        "praep_artikel"
      ]
    },
    {
      "id": "s19",
      "text": "Meu pai é aposentado.",
      "de": "Mein Vater ist pensioniert.",
      "words": [
        "pai",
        "aposentado"
      ],
      "grammar": [
        "possessiv",
        "ser_estar"
      ]
    },
    {
      "id": "s20",
      "text": "Minha mãe está muito feliz.",
      "de": "Meine Mutter ist sehr glücklich.",
      "words": [
        "mae",
        "muito",
        "feliz"
      ],
      "grammar": [
        "possessiv",
        "ser_estar"
      ]
    },
    {
      "id": "s21",
      "text": "Tenho dois irmãos e uma irmã.",
      "de": "Ich habe zwei Brüder und eine Schwester.",
      "words": [
        "num_2",
        "irma",
        "ter"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s22",
      "text": "Meu irmão mora em Berlim.",
      "de": "Mein Bruder wohnt in Berlin.",
      "words": [
        "irmao",
        "morar"
      ],
      "grammar": [
        "possessiv"
      ]
    },
    {
      "id": "s23",
      "text": "A minha família é grande.",
      "de": "Meine Familie ist gross.",
      "words": [
        "familia",
        "grande"
      ],
      "grammar": [
        "possessiv",
        "ser_estar"
      ]
    },
    {
      "id": "s24",
      "text": "Ela é minha namorada.",
      "de": "Sie ist meine Freundin.",
      "words": [
        "ela",
        "namorada"
      ],
      "grammar": [
        "possessiv"
      ]
    },
    {
      "id": "s25",
      "text": "O namorado dela é muito simpático.",
      "de": "Ihr Freund ist sehr sympathisch.",
      "words": [
        "namorado",
        "muito",
        "simpatico"
      ],
      "grammar": [
        "possessiv"
      ]
    },
    {
      "id": "s26",
      "text": "Meu avô tem noventa anos.",
      "de": "Mein Grossvater ist neunzig Jahre alt.",
      "words": [
        "avo_m",
        "num_90",
        "ano"
      ],
      "grammar": [
        "possessiv"
      ]
    },
    {
      "id": "s27",
      "text": "A minha avó cozinha muito bem.",
      "de": "Meine Grossmutter kocht sehr gut.",
      "words": [
        "avo_f",
        "muito",
        "bem"
      ],
      "grammar": [
        "possessiv"
      ]
    },
    {
      "id": "s28",
      "text": "Ele é um bom amigo.",
      "de": "Er ist ein guter Freund.",
      "words": [
        "ele",
        "amigo"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s29",
      "text": "O que você faz?",
      "de": "Was machst du beruflich?",
      "words": [
        "o_que",
        "voce"
      ]
    },
    {
      "id": "s30",
      "text": "Qual é a sua profissão?",
      "de": "Was ist Ihr Beruf?",
      "words": [
        "qual",
        "profissao"
      ],
      "grammar": [
        "possessiv"
      ]
    },
    {
      "id": "s31",
      "text": "Eu sou engenheiro.",
      "de": "Ich bin Ingenieur.",
      "words": [
        "eu",
        "engenheiro"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s32",
      "text": "Ela é professora de inglês.",
      "de": "Sie ist Englischlehrerin.",
      "words": [
        "ela",
        "professor"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s33",
      "text": "Eu trabalho numa empresa de software.",
      "de": "Ich arbeite in einer Softwarefirma.",
      "words": [
        "eu",
        "trabalhar",
        "empresa"
      ]
    },
    {
      "id": "s34",
      "text": "O trabalho é interessante, mas cansativo.",
      "de": "Die Arbeit ist interessant, aber anstrengend.",
      "words": [
        "trabalho",
        "interessante"
      ]
    },
    {
      "id": "s35",
      "text": "Eu já sou aposentado.",
      "de": "Ich bin schon pensioniert.",
      "words": [
        "eu",
        "aposentado"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s36",
