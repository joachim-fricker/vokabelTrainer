  "grammar": [
    {
      "id": "obrigado_obrigada",
      "title": "obrigado oder obrigada?",
      "explanation": "„Obrigado“ heisst wörtlich „verpflichtet“. Die Form richtet sich deshalb nach der Person, die sich bedankt, nicht nach der Person, der man dankt.\n\n• Ein Mann sagt: obrigado\n• Eine Frau sagt: obrigada\n\nVerstärkt: muito obrigado / muito obrigada (vielen Dank).",
      "examples": [
        {
          "text": "Obrigado! (sagt Peter)",
          "de": "Danke!"
        },
        {
          "text": "Obrigada! (sagt Maria)",
          "de": "Danke!"
        }
      ]
    },
    {
      "id": "voce",
      "title": "você – die brasilianische Anrede",
      "explanation": "In den meisten Regionen Brasiliens sagt man für „du“ und für ein lockeres „Sie“ einfach você.\n\nDas Verb steht dabei in derselben Form wie bei „er/sie“ (3. Person): você fala = du sprichst.\n\nBesonders höflich, etwa gegenüber älteren Menschen: o senhor (zu einem Mann) bzw. a senhora (zu einer Frau). Auch hier steht das Verb in der 3. Person.",
      "examples": [
        {
          "text": "Você fala alemão?",
          "de": "Sprichst du Deutsch?"
        },
        {
          "text": "A senhora fala alemão?",
          "de": "Sprechen Sie Deutsch? (zu einer Frau)"
        }
      ]
    },
    {
      "id": "verneinung",
      "title": "Verneinung mit não",
      "explanation": "„Não“ bedeutet sowohl „nein“ als auch „nicht“.\n\nUm einen Satz zu verneinen, stellt man não einfach direkt vor das Verb.\n\nAuf eine Frage antwortet man oft doppelt: Não, não falo. (Nein, spreche ich nicht.)",
      "examples": [
        {
          "text": "Eu entendo.",
          "de": "Ich verstehe."
        },
        {
          "text": "Eu não entendo.",
          "de": "Ich verstehe nicht."
        },
        {
          "text": "Não, não falo alemão.",
          "de": "Nein, ich spreche kein Deutsch."
        }
      ]
    }
  ]
}