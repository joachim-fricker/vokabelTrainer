  "sentences": [
    {
      "id": "s01",
      "text": "Socorro! Chame uma ambulância!",
      "de": "Hilfe! Rufen Sie einen Krankenwagen!",
      "words": [
        "socorro",
        "ambulancia",
        "chamar"
      ],
      "grammar": [
        "anweisungen"
      ]
    },
    {
      "id": "s02",
      "text": "É uma emergência!",
      "de": "Es ist ein Notfall!",
      "words": [
        "emergencia"
      ]
    },
    {
      "id": "s03",
      "text": "Eu preciso de um médico.",
      "de": "Ich brauche einen Arzt.",
      "words": [
        "eu",
        "medico",
        "precisar"
      ],
      "grammar": [
        "precisar_de"
      ]
    },
    {
      "id": "s04",
      "text": "Onde fica o hospital mais perto?",
      "de": "Wo ist das nächste Krankenhaus?",
      "words": [
        "onde",
        "hospital",
        "perto",
        "ficar"
      ]
    },
    {
      "id": "s05",
      "text": "Leve ele ao pronto-socorro.",
      "de": "Bring ihn in die Notaufnahme.",
      "words": [
        "pronto_socorro",
        "levar"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s06",
      "text": "Tem uma farmácia aqui perto?",
      "de": "Gibt es hier in der Nähe eine Apotheke?",
      "words": [
        "farmacia",
        "aqui",
        "perto"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s07",
      "text": "Estou com dor de cabeça.",
      "de": "Ich habe Kopfschmerzen.",
      "words": [
        "dor",
        "cabeca"
      ],
      "grammar": [
        "doer",
        "estar_com"
      ]
    },
    {
      "id": "s08",
      "text": "Estou com dor de garganta e tosse.",
      "de": "Ich habe Halsschmerzen und Husten.",
      "words": [
        "dor",
        "garganta",
        "tosse"
      ],
      "grammar": [
        "doer",
        "estar_com"
      ]
    },
    {
      "id": "s09",
      "text": "Minhas costas doem muito.",
      "de": "Mein Rücken tut sehr weh.",
      "words": [
        "costas",
        "doer",
        "muito"
      ],
      "grammar": [
        "doer"
      ]
    },
    {
      "id": "s10",
      "text": "Dói aqui, na barriga.",
      "de": "Es tut hier weh, am Bauch.",
      "words": [
        "doer",
        "aqui",
        "barriga"
      ],
      "grammar": [
        "doer",
        "praep_artikel"
      ]
    },
    {
      "id": "s11",
      "text": "Meu estômago não está bem.",
      "de": "Mein Magen ist nicht in Ordnung.",
      "words": [
        "estomago",
        "nao",
        "bem"
      ]
    },
    {
      "id": "s12",
      "text": "Acho que estou com febre.",
      "de": "Ich glaube, ich habe Fieber.",
      "words": [
        "febre"
      ],
      "grammar": [
        "estar_com"
      ]
    },
    {
      "id": "s13",
      "text": "Eu acho que é gripe.",
      "de": "Ich glaube, es ist eine Grippe.",
      "words": [
        "eu",
        "gripe"
      ]
    },
    {
      "id": "s14",
      "text": "É só um resfriado.",
      "de": "Es ist nur eine Erkältung.",
      "words": [
        "resfriado"
      ]
    },
    {
      "id": "s15",
      "text": "Estou com diarreia desde ontem.",
      "de": "Ich habe seit gestern Durchfall.",
      "words": [
        "diarreia",
        "ontem"
      ],
      "grammar": [
        "estar_com"
      ]
    },
    {
      "id": "s16",
      "text": "Tenho alergia a amendoim.",
      "de": "Ich habe eine Erdnussallergie.",
      "words": [
        "alergia",
        "ter"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s17",
      "text": "Eu tenho alergia a penicilina.",
      "de": "Ich bin allergisch gegen Penicillin.",
      "words": [
        "eu",
        "alergia",
        "ter"
      ]
    },
    {
      "id": "s18",
      "text": "Tenho uma picada de mosquito no braço.",
      "de": "Ich habe einen Mückenstich am Arm.",
      "words": [
        "picada",
        "braco",
        "ter"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s19",
      "text": "A picada está muito vermelha.",
      "de": "Der Stich ist sehr rot.",
      "words": [
        "picada",
        "muito",
        "vermelho"
      ]
    },
    {
      "id": "s20",
      "text": "Fiquei com queimadura de sol na praia.",
      "de": "Ich habe am Strand einen Sonnenbrand bekommen.",
      "words": [
        "queimadura",
        "praia"
      ]
    },
    {
      "id": "s21",
      "text": "Estou doente, não vou trabalhar hoje.",
      "de": "Ich bin krank, ich gehe heute nicht arbeiten.",
      "words": [
        "doente",
        "nao",
        "hoje"
      ],
      "grammar": [
        "ir_futuro"
      ]
    },
    {
      "id": "s22",
      "text": "Estou tonto e enjoado.",
      "de": "Mir ist schwindlig und übel.",
      "words": [
        "tonto",
        "enjoado"
      ]
    },
    {
      "id": "s23",
      "text": "Estou muito cansado.",
      "de": "Ich bin sehr müde.",
      "words": [
        "muito",
        "cansado"
      ]
    },
    {
      "id": "s24",
      "text": "Ele está machucado na perna.",
      "de": "Er ist am Bein verletzt.",
      "words": [
        "machucado",
        "perna"
      ]
    },
    {
      "id": "s25",
      "text": "Machuquei o pé.",
      "de": "Ich habe mir den Fuss verletzt.",
      "words": [
        "pe"
      ]
    },
    {
      "id": "s26",
      "text": "Quebrei o braço.",
      "de": "Ich habe mir den Arm gebrochen.",
      "words": [
        "braco"
      ]
    },
    {
      "id": "s27",
      "text": "Cortei a mão com a faca.",
      "de": "Ich habe mich mit dem Messer in die Hand geschnitten.",
      "words": [
        "mao",
        "faca",
        "com"
      ]
    },
    {
      "id": "s28",
      "text": "Meu olho está vermelho.",
      "de": "Mein Auge ist rot.",
      "words": [
        "olho",
        "vermelho"
      ]
    },
    {
      "id": "s29",
      "text": "Estou com dor de ouvido.",
      "de": "Ich habe Ohrenschmerzen.",
      "words": [
        "dor",
        "ouvido"
      ],
      "grammar": [
        "estar_com"
      ]
    },
    {
      "id": "s30",
      "text": "O nariz está entupido.",
      "de": "Die Nase ist verstopft.",
      "words": [
        "nariz"
      ]
    },
    {
      "id": "s31",
      "text": "Estou com dor de dente.",
      "de": "Ich habe Zahnschmerzen.",
      "words": [
        "dor",
        "dente"
      ],
      "grammar": [
        "estar_com"
      ]
    },
    {
      "id": "s32",
      "text": "Abra a boca, por favor.",
      "de": "Öffnen Sie bitte den Mund.",
      "words": [
        "boca",
        "por_favor"
      ],
      "grammar": [
        "anweisungen"
      ]
    },
    {
      "id": "s33",
      "text": "A pele está muito seca.",
      "de": "Die Haut ist sehr trocken.",
      "words": [
        "pele",
        "muito"
      ]
    },
    {
      "id": "s34",
      "text": "Tenho um problema no coração.",
      "de": "Ich habe ein Problem mit dem Herzen.",
      "words": [
        "problema",
        "coracao",
        "ter"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s35",
      "text": "O corpo todo dói.",
      "de": "Der ganze Körper tut weh.",
      "words": [
        "corpo",
        "doer"
      ],
      "grammar": [
        "doer"
      ]
    },
    {
      "id": "s36",
      "text": "Preciso marcar uma consulta.",
      "de": "Ich muss einen Arzttermin vereinbaren.",
      "words": [
        "consulta",
        "precisar"
      ]
    },
    {
