  "grammar": [
    {
      "id": "artikel",
      "title": "Artikel: o, a, um, uma",
      "explanation": "Jedes Nomen ist männlich oder weiblich. Ein Neutrum wie „das“ gibt es nicht.\n\n• bestimmt: o (männlich), a (weiblich) – Mehrzahl: os, as\n• unbestimmt: um (männlich), uma (weiblich)\n\nFaustregel: Wörter auf -o sind meist männlich, Wörter auf -a meist weiblich. Bei anderen Endungen (o café, a carne) einfach mit Artikel lernen.",
      "examples": [
        {
          "text": "o prato – os pratos",
          "de": "der Teller – die Teller"
        },
        {
          "text": "a mesa – as mesas",
          "de": "der Tisch – die Tische"
        },
        {
          "text": "um café, uma cerveja",
          "de": "ein Kaffee, ein Bier"
        }
      ]
    },
    {
      "id": "bestellen",
      "title": "Bestellen: quero und gostaria de",
      "explanation": "• Eu quero … = Ich möchte / will … In Brasilien ganz normal und nicht unhöflich.\n• Eu gostaria de … = Ich hätte gern … (etwas höflicher).\n\nNach „gostaria de“ folgt ein Nomen oder ein Verb in der Grundform: Eu gostaria de pagar. (Ich würde gern bezahlen.)\n\nUmgangssprachlich hört man auch: Me vê um café, por favor!",
      "examples": [
        {
          "text": "Eu quero um suco.",
          "de": "Ich möchte einen Saft."
        },
        {
          "text": "Eu gostaria de uma mesa.",
          "de": "Ich hätte gern einen Tisch."
        },
        {
          "text": "Eu gostaria de pagar.",
          "de": "Ich würde gern bezahlen."
        }
      ]
    },
    {
      "id": "estar_com",
      "title": "Hunger und Durst: estar com …",
      "explanation": "Hunger oder Durst „hat“ man im Portugiesischen nicht, man „ist mit“ Hunger: estar com fome.\n\nestar (sein) ändert sich nach der Person:\n• eu estou – ich bin\n• você está – du bist / Sie sind\n\nGenauso: estar com frio (frieren), estar com calor (es heiss haben), estar com pressa (in Eile sein).",
      "examples": [
        {
          "text": "Estou com fome.",
          "de": "Ich habe Hunger."
        },
        {
          "text": "Estou com sede.",
          "de": "Ich habe Durst."
        },
        {
          "text": "Você está com pressa?",
          "de": "Bist du in Eile?"
        }
      ]
    },
    {
      "id": "plural",
      "title": "Die Mehrzahl (Plural)",
      "explanation": "Meist hängt man einfach -s an. Der Artikel wird zu os bzw. as:\no prato → os pratos, a mesa → as mesas\n\nBesondere Endungen:\n• -r, -z → -es: a colher → as colheres, o mar → os mares\n• -l → -is: o real → os reais\n• -m → -ns: o homem → os homens\n• -ão → meist -ões: o camarão → os camarões (seltener -ães oder -ãos: o pão → os pães)\n\nAuch Adjektive stehen in der Mehrzahl: os legumes frios.",
      "examples": [
        {
          "text": "o copo – os copos",
          "de": "das Glas – die Gläser"
        },
        {
          "text": "a colher – as colheres",
          "de": "der Löffel – die Löffel"
        },
        {
          "text": "o real – os reais",
          "de": "der Real – die Reais"
        },
        {
          "text": "o pão – os pães",
          "de": "das Brot – die Brote"
        }
      ]
    }
  ]
