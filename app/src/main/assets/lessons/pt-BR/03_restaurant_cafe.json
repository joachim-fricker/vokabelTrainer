  "sentences": [
    {
      "id": "s01",
      "text": "Uma mesa para dois, por favor.",
      "de": "Einen Tisch für zwei, bitte.",
      "words": [
        "mesa",
        "num_2",
        "por_favor"
      ],
      "grammar": [
        "artikel"
      ]
    },
    {
      "id": "s02",
      "text": "O cardápio, por favor.",
      "de": "Die Speisekarte, bitte.",
      "words": [
        "cardapio",
        "por_favor"
      ],
      "grammar": [
        "artikel"
      ]
    },
    {
      "id": "s03",
      "text": "Eu gostaria de um café.",
      "de": "Ich hätte gern einen Kaffee.",
      "words": [
        "eu",
        "gostaria",
        "cafe"
      ],
      "grammar": [
        "bestellen"
      ]
    },
    {
      "id": "s04",
      "text": "Eu quero uma água sem gás.",
      "de": "Ich möchte ein stilles Wasser.",
      "words": [
        "eu",
        "querer",
        "agua",
        "sem"
      ],
      "grammar": [
        "bestellen"
      ]
    },
    {
      "id": "s05",
      "text": "Uma cerveja bem gelada, por favor.",
      "de": "Ein schön kaltes Bier, bitte.",
      "words": [
        "cerveja",
        "por_favor"
      ]
    },
    {
      "id": "s06",
      "text": "Mais um copo de vinho, por favor.",
      "de": "Noch ein Glas Wein, bitte.",
      "words": [
        "copo",
        "vinho",
        "por_favor"
      ]
    },
    {
      "id": "s07",
      "text": "Um suco de laranja, por favor.",
      "de": "Einen Orangensaft, bitte.",
      "words": [
        "suco",
        "por_favor"
      ]
    },
    {
      "id": "s08",
      "text": "O que você quer beber?",
      "de": "Was möchtest du trinken?",
      "words": [
        "voce",
        "querer",
        "beber"
      ],
      "grammar": [
        "bestellen"
      ]
    },
    {
      "id": "s09",
      "text": "Vocês têm prato vegetariano?",
      "de": "Habt ihr ein vegetarisches Gericht?",
      "words": [
        "prato",
        "vegetariano"
      ]
    },
    {
      "id": "s10",
      "text": "Eu não como carne.",
      "de": "Ich esse kein Fleisch.",
      "words": [
        "eu",
        "nao",
        "comer",
        "carne"
      ],
      "grammar": [
        "verneinung"
      ]
    },
    {
      "id": "s11",
      "text": "Frango com arroz e feijão.",
      "de": "Hähnchen mit Reis und Bohnen.",
      "words": [
        "frango",
        "com",
