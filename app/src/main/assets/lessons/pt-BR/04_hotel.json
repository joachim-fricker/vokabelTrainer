  "sentences": [
    {
      "id": "s01",
      "text": "Eu tenho uma reserva no nome de Müller.",
      "de": "Ich habe eine Reservierung auf den Namen Müller.",
      "words": [
        "eu",
        "reserva",
        "ter"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s02",
      "text": "Vocês têm um quarto livre para hoje?",
      "de": "Habt ihr ein freies Zimmer für heute?",
      "words": [
        "quarto",
        "hoje",
        "ter"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s03",
      "text": "Quanto é a diária?",
      "de": "Wie viel kostet eine Nacht?",
      "words": [
        "diaria"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s04",
      "text": "A diária inclui o café da manhã?",
      "de": "Ist das Frühstück im Preis inbegriffen?",
      "words": [
        "diaria",
        "cafe_da_manha"
      ]
    },
    {
      "id": "s05",
      "text": "Um quarto de casal para três noites, por favor.",
      "de": "Ein Doppelzimmer für drei Nächte, bitte.",
      "words": [
        "quarto_casal",
        "num_3",
        "noite",
        "por_favor"
      ]
    },
    {
      "id": "s06",
      "text": "Eu prefiro um quarto de solteiro com vista para o mar.",
      "de": "Ich hätte lieber ein Einzelzimmer mit Meerblick.",
      "words": [
        "eu",
        "quarto_solteiro",
        "vista",
        "com"
      ]
    },
    {
      "id": "s07",
      "text": "Posso ver o seu passaporte?",
      "de": "Darf ich Ihren Pass sehen?",
      "words": [
        "passaporte"
      ]
    },
    {
      "id": "s08",
      "text": "Aqui está a chave do quarto.",
      "de": "Hier ist der Zimmerschlüssel.",
      "words": [
        "chave",
        "quarto"
      ]
    },
    {
      "id": "s09",
      "text": "O quarto fica no terceiro andar.",
      "de": "Das Zimmer ist im dritten Stock.",
      "words": [
        "quarto",
        "ficar",
        "andar"
      ]
    },
    {
      "id": "s10",
      "text": "Onde fica o elevador?",
      "de": "Wo ist der Aufzug?",
      "words": [
        "onde",
        "ficar",
        "elevador"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s11",
      "text": "A que horas é o check-out?",
      "de": "Um wie viel Uhr ist der Check-out?",
      "words": [
        "check_out",
        "hora"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s12",
      "text": "O check-in é a partir das duas da tarde.",
      "de": "Der Check-in ist ab zwei Uhr nachmittags.",
      "words": [
        "check_in",
        "num_2"
      ]
    },
    {
      "id": "s13",
      "text": "Qual é a senha do wi-fi?",
      "de": "Wie lautet das WLAN-Passwort?",
      "words": [
        "qual",
        "senha",
        "wifi"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s14",
      "text": "O wi-fi não funciona.",
      "de": "Das WLAN funktioniert nicht.",
      "words": [
        "wifi",
        "nao",
        "funcionar"
      ]
    },
    {
      "id": "s15",
      "text": "O ar-condicionado está quebrado.",
      "de": "Die Klimaanlage ist kaputt.",
      "words": [
        "ar_condicionado",
        "quebrado"
      ]
    },
    {
      "id": "s16",
      "text": "O chuveiro não tem água quente.",
      "de": "Die Dusche hat kein warmes Wasser.",
      "words": [
        "chuveiro",
        "nao",
        "agua",
        "quente",
        "ter"
      ]
    },
    {
      "id": "s17",
      "text": "Pode trocar as toalhas, por favor?",
      "de": "Können Sie bitte die Handtücher wechseln?",
      "words": [
        "trocar",
        "toalha",
        "por_favor"
      ]
    },
    {
      "id": "s18",
      "text": "Preciso de mais um travesseiro.",
      "de": "Ich brauche noch ein Kopfkissen.",
      "words": [
        "precisar",
        "travesseiro"
      ],
      "grammar": [
        "precisar_de"
      ]
    },
    {
      "id": "s19",
      "text": "Tem um cobertor extra?",
      "de": "Gibt es eine zusätzliche Decke?",
      "words": [
        "cobertor"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s20",
      "text": "O quarto está sujo.",
      "de": "Das Zimmer ist schmutzig.",
      "words": [
        "quarto",
        "sujo"
      ]
    },
    {
      "id": "s21",
      "text": "O banheiro está muito limpo.",
      "de": "Das Bad ist sehr sauber.",
      "words": [
        "banheiro",
        "muito",
        "limpo"
      ]
    },
    {
      "id": "s22",
      "text": "A rua é muito barulhenta à noite.",
      "de": "Die Strasse ist nachts sehr laut.",
      "words": [
        "muito",
        "barulhento",
        "noite"
      ]
    },
    {
      "id": "s23",
      "text": "Posso trocar de quarto?",
      "de": "Kann ich das Zimmer wechseln?",
      "words": [
        "trocar",
        "quarto"
      ]
    },
    {
      "id": "s24",
      "text": "Tem piscina no hotel?",
      "de": "Hat das Hotel einen Pool?",
      "words": [
        "piscina",
        "hotel"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s25",
      "text": "O estacionamento é gratuito?",
      "de": "Ist der Parkplatz kostenlos?",
      "words": [
        "estacionamento"
      ]
    },
    {
      "id": "s26",
      "text": "Tem cofre no quarto?",
      "de": "Gibt es einen Safe im Zimmer?",
      "words": [
        "cofre",
        "quarto"
      ],
      "grammar": [
        "ter_haben"
      ]
    },
    {
      "id": "s27",
      "text": "Onde tem uma tomada?",
      "de": "Wo gibt es eine Steckdose?",
      "words": [
        "onde",
        "tomada"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s28",
      "text": "Esqueci meu carregador.",
      "de": "Ich habe mein Ladegerät vergessen.",
      "words": [
        "carregador"
      ]
    },
    {
      "id": "s29",
      "text": "Quando é a limpeza do quarto?",
      "de": "Wann wird das Zimmer geputzt?",
      "words": [
        "quando",
        "limpeza",
        "quarto"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s30",
      "text": "O hotel tem lavanderia?",
      "de": "Hat das Hotel eine Wäscherei?",
      "words": [
        "hotel",
        "lavanderia",
        "ter"
      ]
    },
    {
      "id": "s31",
      "text": "Quem fala inglês aqui?",
      "de": "Wer spricht hier Englisch?",
      "words": [
        "quem",
        "falar"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s32",
      "text": "Por que a janela não abre?",
      "de": "Warum geht das Fenster nicht auf?",
      "words": [
        "por_que",
        "janela",
        "nao"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s33",
      "text": "Pode fechar a porta, por favor?",
      "de": "Kannst du bitte die Tür schliessen?",
      "words": [
        "porta",
        "por_favor"
      ]
    },
    {
      "id": "s34",
      "text": "O quarto tem varanda?",
      "de": "Hat das Zimmer einen Balkon?",
      "words": [
        "quarto",
        "varanda",
        "ter"
      ]
    },
    {
      "id": "s35",
      "text": "A cama é muito confortável.",
      "de": "Das Bett ist sehr bequem.",
      "words": [
        "cama",
        "muito"
      ]
    },
    {
      "id": "s36",
      "text": "O ventilador faz muito barulho.",
      "de": "Der Ventilator macht viel Lärm.",
      "words": [
        "ventilador",
        "muito"
      ]
    },
    {
      "id": "s37",
      "text": "Eu vou sair amanhã cedo.",
      "de": "Ich reise morgen früh ab.",
      "words": [
        "eu",
        "sair",
        "amanha"
      ]
    },
    {
      "id": "s38",
      "text": "Nós vamos chegar tarde à noite.",
      "de": "Wir kommen spät abends an.",
      "words": [
        "chegar",
        "noite"
      ]
    },
    {
