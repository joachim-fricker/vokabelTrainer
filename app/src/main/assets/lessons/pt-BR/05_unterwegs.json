  "sentences": [
    {
      "id": "s01",
      "text": "Onde fica o ponto de ônibus?",
      "de": "Wo ist die Bushaltestelle?",
      "words": [
        "onde",
        "ponto_onibus",
        "ficar"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s02",
      "text": "Esse ônibus vai para o centro?",
      "de": "Fährt dieser Bus ins Zentrum?",
      "words": [
        "onibus",
        "ir",
        "centro"
      ],
      "grammar": [
        "ir_futuro"
      ]
    },
    {
      "id": "s03",
      "text": "Eu vou pegar o metrô.",
      "de": "Ich nehme die U-Bahn.",
      "words": [
        "eu",
        "pegar",
        "metro",
        "ir"
      ],
      "grammar": [
        "ir_futuro"
      ]
    },
    {
      "id": "s04",
      "text": "Uma passagem para o Rio, por favor.",
      "de": "Eine Fahrkarte nach Rio, bitte.",
      "words": [
        "passagem",
        "por_favor"
      ]
    },
    {
      "id": "s05",
      "text": "Ida e volta, por favor.",
      "de": "Hin und zurück, bitte.",
      "words": [
        "ida_e_volta",
        "por_favor"
      ]
    },
    {
      "id": "s06",
      "text": "A que horas sai o próximo ônibus?",
      "de": "Wann fährt der nächste Bus?",
      "words": [
        "onibus",
        "hora",
        "sair"
      ]
    },
    {
      "id": "s07",
      "text": "Onde é a bilheteria?",
      "de": "Wo ist der Ticketschalter?",
      "words": [
        "onde",
        "bilheteria"
      ]
    },
    {
      "id": "s08",
      "text": "Quanto tempo leva até a rodoviária?",
      "de": "Wie lange dauert es bis zum Busbahnhof?",
      "words": [
        "levar",
        "rodoviaria"
      ]
    },
    {
      "id": "s09",
      "text": "Leva uns vinte minutos de táxi.",
      "de": "Mit dem Taxi dauert es etwa zwanzig Minuten.",
      "words": [
        "levar",
        "num_20",
        "minuto",
        "taxi"
      ]
    },
    {
      "id": "s10",
      "text": "O meu voo está atrasado.",
      "de": "Mein Flug hat Verspätung.",
      "words": [
        "voo",
        "atrasado"
      ]
    },
    {
      "id": "s11",
      "text": "O embarque é no portão doze.",
      "de": "Das Boarding ist an Gate zwölf.",
      "words": [
        "embarque",
        "portao",
        "num_12"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s12",
      "text": "Perdi o meu voo!",
      "de": "Ich habe meinen Flug verpasst!",
      "words": [
        "perder",
        "voo"
      ]
    },
    {
      "id": "s13",
      "text": "A minha mala não chegou.",
      "de": "Mein Koffer ist nicht angekommen.",
      "words": [
        "mala",
        "nao",
        "chegar"
      ]
    },
    {
      "id": "s14",
      "text": "Quantas malas você tem?",
      "de": "Wie viele Koffer hast du?",
      "words": [
        "mala",
        "voce",
        "ter"
      ],
      "grammar": [
        "fragewoerter"
      ]
    },
    {
      "id": "s15",
      "text": "Só tenho uma mochila e uma mala pequena.",
      "de": "Ich habe nur einen Rucksack und einen kleinen Koffer.",
      "words": [
        "mochila",
        "mala"
      ]
    },
    {
      "id": "s16",
      "text": "A bagagem de mão pode ter dez quilos.",
      "de": "Das Handgepäck darf zehn Kilo haben.",
      "words": [
        "bagagem",
        "num_10",
        "ter"
      ]
    },
    {
      "id": "s17",
      "text": "Como eu chego ao aeroporto?",
      "de": "Wie komme ich zum Flughafen?",
      "words": [
        "como",
        "chegar",
        "aeroporto"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s18",
      "text": "Onde fica a estação de metrô?",
      "de": "Wo ist die U-Bahn-Station?",
      "words": [
        "onde",
        "estacao",
        "metro",
        "ficar"
      ]
    },
    {
      "id": "s19",
      "text": "O trem para São Paulo sai às oito.",
      "de": "Der Zug nach São Paulo fährt um acht.",
      "words": [
        "trem",
        "num_8",
        "sair"
      ]
    },
    {
      "id": "s20",
      "text": "Qual é o horário do trem?",
      "de": "Wie ist der Fahrplan des Zuges?",
      "words": [
        "qual",
        "horario",
        "trem"
      ]
    },
    {
      "id": "s21",
      "text": "Siga reto e vire à direita.",
      "de": "Gehen Sie geradeaus und biegen Sie rechts ab.",
      "words": [
        "reto",
        "direita"
      ],
      "grammar": [
        "anweisungen"
      ]
    },
    {
      "id": "s22",
      "text": "Na esquina, vire à esquerda.",
      "de": "An der Ecke biegen Sie links ab.",
      "words": [
        "esquina",
        "esquerda"
      ],
      "grammar": [
        "anweisungen",
        "praep_artikel"
      ]
    },
    {
      "id": "s23",
      "text": "Depois do semáforo, é a segunda rua.",
      "de": "Nach der Ampel ist es die zweite Strasse.",
      "words": [
        "semaforo",
        "rua"
      ]
    },
    {
      "id": "s24",
      "text": "O museu fica na avenida principal.",
      "de": "Das Museum liegt an der Hauptstrasse.",
      "words": [
        "museu",
        "avenida",
        "ficar"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s25",
      "text": "A igreja fica ao lado da praça.",
      "de": "Die Kirche ist neben dem Platz.",
      "words": [
        "igreja",
        "ao_lado",
        "praca",
        "ficar"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s26",
      "text": "O banco fica atrás do museu.",
      "de": "Die Bank ist hinter dem Museum.",
      "words": [
        "atras",
        "museu",
        "ficar"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s27",
      "text": "É perto ou longe daqui?",
      "de": "Ist es nah oder weit von hier?",
      "words": [
        "perto",
        "longe"
      ]
    },
    {
      "id": "s28",
      "text": "É bem perto, dá para ir a pé.",
      "de": "Es ist ganz nah, man kann zu Fuss gehen.",
      "words": [
        "perto",
        "ir",
        "a_pe"
      ]
    },
    {
      "id": "s29",
      "text": "O hotel é aqui ou ali?",
      "de": "Ist das Hotel hier oder dort?",
      "words": [
        "hotel",
        "aqui",
        "ali"
      ]
    },
    {
      "id": "s30",
      "text": "Pode me mostrar no mapa?",
      "de": "Können Sie es mir auf der Karte zeigen?",
      "words": [
        "mapa"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s31",
      "text": "Desça no próximo ponto de ônibus.",
      "de": "Steigen Sie an der nächsten Bushaltestelle aus.",
      "words": [
        "descer",
        "ponto_onibus"
      ],
      "grammar": [
        "anweisungen",
        "praep_artikel"
      ]
    },
    {
      "id": "s32",
      "text": "Pegue o ônibus número cinco.",
      "de": "Nehmen Sie den Bus Nummer fünf.",
      "words": [
        "pegar",
        "onibus",
        "numero",
        "num_5"
      ],
      "grammar": [
        "anweisungen"
      ]
    },
    {
      "id": "s33",
      "text": "Eu quero alugar um carro.",
      "de": "Ich möchte ein Auto mieten.",
      "words": [
        "eu",
        "alugar",
        "carro"
      ]
    },
    {
      "id": "s34",
      "text": "Preciso da sua carteira de motorista.",
