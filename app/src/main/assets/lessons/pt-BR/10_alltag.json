      "words": [
        "ele",
        "madrugada",
        "chegar"
      ]
    },
    {
      "id": "s30",
      "text": "É muito tarde, vamos dormir.",
      "de": "Es ist sehr spät, lass uns schlafen gehen.",
      "words": [
        "muito",
