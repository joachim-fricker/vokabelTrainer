      "words": [
        "eu",
        "levantar",
        "num_7",
        "manha"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s27",
      "text": "De manhã eu tomo café.",
      "de": "Morgens trinke ich Kaffee.",
      "words": [
        "manha",
        "eu",
        "tomar",
        "cafe"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s28",
      "text": "À tarde eu vou à praia.",
      "de": "Nachmittags gehe ich an den Strand.",
      "words": [
        "tarde_noun",
        "eu",
        "praia",
        "ir"
      ],
      "grammar": [
        "datum",
        "praep_artikel"
      ]
    },
    {
      "id": "s29",
      "text": "Ele chegou de madrugada.",
