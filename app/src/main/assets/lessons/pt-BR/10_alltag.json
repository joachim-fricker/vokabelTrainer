  "sentences": [
    {
      "id": "s01",
      "text": "Hoje é segunda-feira.",
      "de": "Heute ist Montag.",
      "words": [
        "hoje",
        "segunda"
      ],
      "grammar": [
        "datum",
        "ser_estar"
      ]
    },
    {
      "id": "s02",
      "text": "Na terça-feira eu trabalho até tarde.",
      "de": "Am Dienstag arbeite ich bis spät.",
      "words": [
        "terca",
        "eu",
        "trabalhar",
        "tarde_adv"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s03",
      "text": "A feira é toda quarta-feira.",
      "de": "Der Markt ist jeden Mittwoch.",
      "words": [
        "feira",
        "quarta"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s04",
      "text": "Quinta-feira é feriado.",
      "de": "Donnerstag ist Feiertag.",
      "words": [
        "quinta"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s05",
      "text": "Sexta-feira à noite a gente sai.",
      "de": "Freitagabend gehen wir aus.",
      "words": [
        "sexta",
        "noite",
        "a_gente",
        "sair"
      ],
      "grammar": [
        "datum",
        "a_gente"
      ]
    },
    {
      "id": "s06",
      "text": "No sábado eu durmo até tarde.",
      "de": "Am Samstag schlafe ich lange.",
      "words": [
        "sabado",
        "eu",
        "dormir",
        "tarde_adv"
      ],
      "grammar": [
        "datum",
        "unregelmaessig"
      ]
    },
    {
      "id": "s07",
      "text": "O domingo é para a família.",
      "de": "Der Sonntag ist für die Familie.",
      "words": [
        "domingo",
        "familia"
      ]
    },
    {
      "id": "s08",
      "text": "Que dia é hoje?",
      "de": "Welcher Tag ist heute?",
      "words": [
        "dia",
        "hoje"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s09",
      "text": "Hoje é dia cinco de maio.",
      "de": "Heute ist der fünfte Mai.",
      "words": [
        "hoje",
        "dia",
        "num_5",
        "maio"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s10",
      "text": "Eu vou ficar uma semana.",
      "de": "Ich bleibe eine Woche.",
      "words": [
        "eu",
        "ficar",
        "semana",
        "ir"
      ],
      "grammar": [
        "ir_futuro"
      ]
    },
    {
      "id": "s11",
      "text": "O que você vai fazer no fim de semana?",
      "de": "Was machst du am Wochenende?",
      "words": [
        "o_que",
        "voce",
        "fim_de_semana",
        "fazer"
      ],
      "grammar": [
        "ir_futuro"
      ]
    },
    {
      "id": "s12",
      "text": "Eu nasci em janeiro.",
      "de": "Ich bin im Januar geboren.",
      "words": [
        "eu",
        "janeiro"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s13",
      "text": "Em fevereiro é carnaval.",
      "de": "Im Februar ist Karneval.",
      "words": [
        "fevereiro",
        "carnaval"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s14",
      "text": "Em março ainda faz calor.",
      "de": "Im März ist es noch heiss.",
      "words": [
        "marco",
        "ainda",
        "calor"
      ],
      "grammar": [
        "datum",
        "wetter"
      ]
    },
    {
      "id": "s15",
      "text": "Abril é um mês bom para viajar.",
      "de": "Der April ist ein guter Monat zum Reisen.",
      "words": [
        "abril",
        "mes",
        "viajar"
      ]
    },
    {
      "id": "s16",
      "text": "As férias são em julho.",
      "de": "Die Ferien sind im Juli.",
      "words": [
        "ferias",
        "julho"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s17",
      "text": "Em junho tem festa junina.",
      "de": "Im Juni gibt es die Junifeste.",
      "words": [
        "junho",
        "festa"
      ],
      "grammar": [
        "datum",
        "ter_haben"
      ]
    },
    {
      "id": "s18",
      "text": "Agosto é o mês do meu aniversário.",
      "de": "Im August ist mein Geburtstag.",
      "words": [
        "agosto",
        "mes"
      ],
      "grammar": [
        "possessiv"
      ]
    },
    {
      "id": "s19",
      "text": "Setembro e outubro são bons meses para ir ao Nordeste.",
      "de": "September und Oktober sind gute Monate für den Nordosten.",
      "words": [
        "setembro",
        "outubro",
        "ir"
      ]
    },
    {
      "id": "s20",
      "text": "Em novembro começa o calor.",
      "de": "Im November beginnt die Hitze.",
      "words": [
        "novembro",
        "calor"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s21",
      "text": "O Natal é em dezembro, no verão.",
      "de": "Weihnachten ist im Dezember, im Sommer.",
      "words": [
        "dezembro",
        "verao"
      ],
      "grammar": [
        "datum",
        "praep_artikel"
      ]
    },
    {
      "id": "s22",
      "text": "No inverno chove muito em São Paulo?",
      "de": "Regnet es im Winter viel in São Paulo?",
      "words": [
        "inverno",
        "chover",
        "muito"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s23",
      "text": "A primavera começa em setembro.",
      "de": "Der Frühling beginnt im September.",
      "words": [
        "primavera",
        "setembro"
      ],
      "grammar": [
        "datum"
      ]
    },
    {
      "id": "s24",
      "text": "No outono as noites são frescas.",
      "de": "Im Herbst sind die Nächte frisch.",
      "words": [
        "outono"
      ],
      "grammar": [
        "praep_artikel"
      ]
    },
    {
      "id": "s25",
      "text": "Eu acordo cedo todo dia.",
      "de": "Ich wache jeden Tag früh auf.",
      "words": [
        "eu",
        "acordar",
        "cedo",
        "todo_dia"
      ],
      "grammar": [
        "praesens"
      ]
    },
    {
      "id": "s26",
      "text": "Eu me levanto às sete da manhã.",
