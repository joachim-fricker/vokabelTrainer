  "sentences": [
    {
      "id": "s01",
      "text": "Quanto custa isso?",
      "de": "Was kostet das?",
      "words": [
        "quanto_custa"
      ]
    },
    {
      "id": "s02",
      "text": "Custa vinte reais.",
      "de": "Es kostet zwanzig Reais.",
      "words": [
        "quanto_custa",
        "num_20",
        "real"
      ]
    },
    {
      "id": "s03",
      "text": "Nossa, é muito caro!",
      "de": "Wow, das ist sehr teuer!",
      "words": [
        "muito",
        "caro"
      ],
      "grammar": []
    },
    {
      "id": "s04",
      "text": "Aqui é mais barato.",
      "de": "Hier ist es günstiger.",
      "words": [
        "barato"
      ]
    },
    {
      "id": "s05",
      "text": "Qual é o preço?",
      "de": "Wie hoch ist der Preis?",
      "words": [
        "preco"
      ]
    },
    {
      "id": "s06",
      "text": "Posso pagar com cartão?",
      "de": "Kann ich mit Karte bezahlen?",
      "words": [
        "pagar",
        "cartao"
      ]
    },
    {
      "id": "s07",
      "text": "Eu pago em dinheiro.",
      "de": "Ich bezahle bar.",
      "words": [
        "eu",
        "pagar",
        "dinheiro"
      ]
    },
    {
      "id": "s08",
      "text": "Dois cafés, por favor.",
      "de": "Zwei Kaffee, bitte.",
      "words": [
        "num_2",
        "por_favor"
      ],
      "grammar": [
        "zahlen_geschlecht"
      ]
    },
    {
      "id": "s09",
      "text": "Duas águas, por favor.",
      "de": "Zwei Wasser, bitte.",
      "words": [
        "num_2",
        "por_favor"
      ],
      "grammar": [
        "zahlen_geschlecht"
      ]
    },
    {
      "id": "s10",
      "text": "Que horas são?",
      "de": "Wie spät ist es?",
      "words": [
        "que_horas"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s11",
      "text": "É uma hora.",
      "de": "Es ist ein Uhr.",
      "words": [
        "num_1",
        "hora"
      ],
      "grammar": [
        "uhrzeit",
        "zahlen_geschlecht"
      ]
    },
    {
      "id": "s12",
      "text": "São três e meia.",
      "de": "Es ist halb vier. (3:30 Uhr)",
      "words": [
        "num_3",
        "e_meia"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s13",
      "text": "Já é meio-dia.",
      "de": "Es ist schon Mittag.",
      "words": [
        "meio_dia"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s14",
      "text": "A loja abre às nove.",
      "de": "Der Laden öffnet um neun.",
      "words": [
        "num_9"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s15",
      "text": "Até amanhã às dez!",
      "de": "Bis morgen um zehn!",
      "words": [
        "ate_amanha",
        "num_10"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s16",
      "text": "Hoje eu tenho cinquenta reais.",
      "de": "Heute habe ich fünfzig Reais.",
      "words": [
        "hoje",
        "eu",
        "num_50",
        "real"
      ]
    },
    {
      "id": "s17",
      "text": "Ontem estava mais barato.",
      "de": "Gestern war es günstiger.",
      "words": [
        "ontem",
        "barato"
      ]
    },
    {
      "id": "s18",
      "text": "Volto em cinco minutos.",
      "de": "Ich bin in fünf Minuten zurück.",
      "words": [
        "num_5",
        "minuto"
      ]
    },
    {
      "id": "s19",
      "text": "O hotel custa cem reais por noite.",
      "de": "Das Hotel kostet hundert Reais pro Nacht.",
      "words": [
        "num_100",
        "real"
      ]
    },
    {
      "id": "s20",
      "text": "O restaurante fecha à meia-noite.",
      "de": "Das Restaurant schliesst um Mitternacht.",
      "words": [
        "meia_noite"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s21",
      "text": "O quarto custa trezentos e cinquenta reais.",
      "de": "Das Zimmer kostet dreihundertfünfzig Reais.",
      "words": [
        "num_300",
        "num_50",
        "real"
      ],
      "grammar": [
        "grosse_zahlen"
      ]
    },
    {
      "id": "s22",
      "text": "A passagem custa mil e duzentos reais.",
      "de": "Das Ticket kostet tausendzweihundert Reais.",
      "words": [
        "num_1000",
        "num_200",
        "real"
      ],
      "grammar": [
        "grosse_zahlen"
      ]
    },
    {
      "id": "s23",
      "text": "Custa noventa e nove reais.",
      "de": "Es kostet neunundneunzig Reais.",
      "words": [
        "num_90",
        "num_9",
        "real"
      ],
      "grammar": [
        "grosse_zahlen"
      ]
    },
    {
      "id": "s24",
      "text": "São dezoito reais e cinquenta centavos.",
      "de": "Das macht achtzehn Reais fünfzig.",
      "words": [
        "num_18",
        "real",
        "num_50",
        "centavo"
      ]
    },
    {
      "id": "s25",
      "text": "Eu nasci em mil novecentos e setenta.",
      "de": "Ich bin neunzehnhundertsiebzig geboren.",
      "words": [
        "num_1000",
        "num_900",
        "num_70"
      ],
      "grammar": [
        "grosse_zahlen"
      ]
    },
    {
      "id": "s26",
      "text": "Pegue o ônibus quarenta e dois.",
      "de": "Nimm den Bus zweiundvierzig.",
      "words": [
        "num_40",
        "num_2"
      ]
    },
    {
      "id": "s27",
      "text": "Ela tem sessenta anos.",
      "de": "Sie ist sechzig Jahre alt.",
      "words": [
        "num_60",
        "ano"
      ]
    },
    {
      "id": "s28",
      "text": "Quinhentos gramas de queijo, por favor.",
      "de": "Fünfhundert Gramm Käse, bitte.",
      "words": [
        "num_500",
        "por_favor"
      ]
    },
    {
      "id": "s29",
      "text": "São Paulo tem mais de doze milhões de habitantes.",
      "de": "São Paulo hat über zwölf Millionen Einwohner.",
      "words": [
        "num_12",
        "num_milhao"
      ],
      "grammar": [
        "grosse_zahlen"
      ]
    },
    {
      "id": "s30",
      "text": "São quinze para as oito.",
      "de": "Es ist Viertel vor acht.",
      "words": [
        "quinze_para",
        "num_8"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s31",
      "text": "O voo sai às dezesseis horas.",
      "de": "Der Flug geht um sechzehn Uhr.",
      "words": [
        "num_16",
        "hora"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s32",
      "text": "Qual é o seu número de telefone?",
      "de": "Wie ist deine Telefonnummer?",
      "words": [
        "numero"
      ]
    },
    {
      "id": "s33",
      "text": "Tem desconto se eu pagar em dinheiro?",
      "de": "Gibt es Rabatt, wenn ich bar bezahle?",
      "words": [
        "desconto",
        "pagar",
        "dinheiro"
      ]
    },
    {
      "id": "s34",
      "text": "Desculpa, não tenho troco.",
      "de": "Entschuldigung, ich habe kein Wechselgeld.",
      "words": [
        "desculpa",
        "nao",
        "troco"
      ]
    },
