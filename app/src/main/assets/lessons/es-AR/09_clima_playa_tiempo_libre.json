  "sentences": [
    {
      "id": "s01",
      "text": "¿Qué tiempo hace hoy?",
      "de": "Wie ist das Wetter heute?",
      "words": [
        "tiempo",
        "hacer"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s02",
      "text": "Hace mucho calor.",
      "de": "Es ist sehr heiss.",
      "words": [
        "calor",
        "hacer",
        "mucho"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s03",
      "text": "Hace frío a la noche.",
      "de": "Nachts ist es kalt.",
      "words": [
        "frio",
        "hacer",
        "noche"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s04",
      "text": "Hay mucho sol.",
      "de": "Es ist sehr sonnig.",
      "words": [
        "sol",
        "hay",
        "mucho"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s05",
      "text": "Está nublado.",
      "de": "Es ist bewölkt.",
      "words": [
        "nublado"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s06",
      "text": "Va a llover a la tarde.",
      "de": "Am Nachmittag wird es regnen.",
      "words": [
        "llover",
        "tarde_n"
      ],
      "grammar": [
        "ir_a"
      ]
    },
    {
      "id": "s07",
      "text": "Llueve mucho en invierno.",
      "de": "Im Winter regnet es viel.",
      "words": [
        "llover",
        "invierno",
        "mucho"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s08",
      "text": "Con lluvia no vamos a la playa.",
      "de": "Bei Regen gehen wir nicht an den Strand.",
      "words": [
        "lluvia",
        "playa"
      ]
    },
    {
      "id": "s09",
      "text": "Hay mucho viento en la costa.",
      "de": "An der Küste ist viel Wind.",
      "words": [
        "viento",
        "hay",
        "mucho"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s10",
      "text": "Hay mucha humedad en Buenos Aires.",
      "de": "In Buenos Aires ist die Luftfeuchtigkeit hoch.",
      "words": [
        "humedad",
        "mucho"
      ]
    },
    {
      "id": "s11",
      "text": "Se viene una tormenta.",
      "de": "Ein Gewitter zieht auf.",
      "words": [
        "tormenta"
      ]
    },
    {
      "id": "s12",
      "text": "Hace treinta grados.",
      "de": "Es sind dreissig Grad.",
      "words": [
        "grado",
        "treinta",
        "hacer"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s13",
      "text": "¿Viste el pronóstico?",
      "de": "Hast du die Wettervorhersage gesehen?",
      "words": [
        "pronostico",
        "ver"
      ]
    },
    {
      "id": "s14",
      "text": "El clima en Mendoza es seco.",
      "de": "Das Klima in Mendoza ist trocken.",
      "words": [
        "clima"
      ]
    },
    {
      "id": "s15",
      "text": "En diciembre es verano en Argentina.",
      "de": "Im Dezember ist in Argentinien Sommer.",
      "words": [
        "verano",
        "argentina"
      ]
    },
    {
      "id": "s16",
      "text": "En invierno hace frío en el sur.",
      "de": "Im Winter ist es im Süden kalt.",
      "words": [
        "invierno",
        "frio",
        "hacer"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s17",
      "text": "Vamos a la playa.",
      "de": "Gehen wir an den Strand.",
      "words": [
        "playa",
        "ir"
      ],
      "grammar": [
        "del_al"
      ]
    },
    {
      "id": "s18",
      "text": "El mar está frío hoy.",
      "de": "Das Meer ist heute kalt.",
      "words": [
        "mar",
        "frio"
      ]
    },
    {
      "id": "s19",
      "text": "¡Cuidado con la ola!",
      "de": "Vorsicht vor der Welle!",
      "words": [
        "ola",
        "cuidado"
      ]
    },
    {
      "id": "s20",
      "text": "La arena está muy caliente.",
      "de": "Der Sand ist sehr heiss.",
      "words": [
        "arena",
        "caliente",
        "muy"
      ]
    },
    {
      "id": "s21",
      "text": "Me olvidé la malla.",
      "de": "Ich habe die Badehose vergessen.",
      "words": [
        "malla"
      ]
    },
    {
      "id": "s22",
      "text": "¿Cuánto cuesta alquilar una sombrilla?",
      "de": "Wie viel kostet es, einen Sonnenschirm zu mieten?",
      "words": [
        "sombrilla",
        "alquilar",
        "cuanto"
      ]
    },
    {
      "id": "s23",
      "text": "Estoy tomando sol en la reposera.",
      "de": "Ich sonne mich im Liegestuhl.",
      "words": [
        "reposera",
        "sol"
      ],
      "grammar": [
        "estar_gerundio"
      ]
    },
    {
      "id": "s24",
      "text": "¿Se puede nadar acá?",
      "de": "Kann man hier schwimmen?",
      "words": [
        "nadar",
        "aca"
      ]
    },
    {
      "id": "s25",
      "text": "Prefiero la sombra.",
      "de": "Ich bin lieber im Schatten.",
      "words": [
        "sombra"
      ]
    },
    {
      "id": "s26",
      "text": "Hacemos una excursión a la montaña.",
      "de": "Wir machen einen Ausflug in die Berge.",
      "words": [
        "excursion",
        "montana",
        "hacer"
      ],
      "grammar": [
        "presente"
      ]
    },
    {
      "id": "s27",
      "text": "El lago es hermoso.",
      "de": "Der See ist wunderschön.",
      "words": [
        "lago"
      ]
    },
    {
      "id": "s28",
      "text": "Caminamos por el río.",
      "de": "Wir spazieren am Fluss entlang.",
      "words": [
        "rio",
        "caminar"
      ],
      "grammar": [
        "presente"
      ]
    },
    {
      "id": "s29",
      "text": "¿Te gusta el fútbol?",
      "de": "Magst du Fussball?",
      "words": [
        "futbol",
        "gustar"
      ],
      "grammar": [
        "gustar"
      ]
    },
    {
      "id": "s30",
      "text": "El domingo hay partido de Boca.",
      "de": "Am Sonntag spielt Boca.",
      "words": [
        "partido",
        "hay"
      ]
    },
    {
      "id": "s31",
      "text": "¿Dónde queda la cancha?",
      "de": "Wo ist das Stadion?",
      "words": [
        "cancha",
        "donde"
      ]
    },
    {
      "id": "s32",
      "text": "Quiero ver un show de tango.",
      "de": "Ich möchte eine Tangoshow sehen.",
      "words": [
        "tango",
        "ver",
        "querer"
      ]
    },
    {
      "id": "s33",
      "text": "¿Bailás tango?",
      "de": "Tanzt du Tango?",
      "words": [
        "bailar",
        "tango"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s34",
      "text": "Me gusta escuchar música.",
      "de": "Ich höre gern Musik.",
      "words": [
        "escuchar",
        "musica",
        "gustar"
      ],
      "grammar": [
        "gustar"
      ]
    },
    {
      "id": "s35",
      "text": "¿El museo está abierto los lunes?",
      "de": "Ist das Museum montags geöffnet?",
      "words": [
        "museo",
        "abierto"
      ]
    },
    {
      "id": "s36",
      "text": "Vamos al teatro esta noche.",
      "de": "Wir gehen heute Abend ins Theater.",
      "words": [
        "teatro",
        "noche"
      ],
      "grammar": [
        "del_al"
      ]
    },
    {
      "id": "s37",
      "text": "¿Vamos al cine?",
      "de": "Gehen wir ins Kino?",
      "words": [
        "cine"
      ],
      "grammar": [
        "del_al"
      ]
    },
    {
      "id": "s38",
      "text": "Dos entradas, por favor.",
      "de": "Zwei Eintrittskarten, bitte.",
      "words": [
        "entrada",
        "dos"
      ]
    },
    {
      "id": "s39",
      "text": "¿Puedo sacar fotos?",
      "de": "Darf ich Fotos machen?",
      "words": [
        "sacar_fotos"
      ]
    },
    {
      "id": "s40",
      "text": "Los chicos juegan en la plaza.",
      "de": "Die Kinder spielen auf dem Platz.",
      "words": [
        "jugar",
        "chicos",
        "plaza"
      ],
      "grammar": [
        "presente"
      ]
    },
    {
      "id": "s41",
      "text": "¿Jugás al fútbol?",
      "de": "Spielst du Fussball?",
      "words": [
        "jugar",
        "futbol"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s42",
      "text": "Hoy quiero descansar.",
      "de": "Heute möchte ich mich ausruhen.",
      "words": [
        "descansar",
        "querer"
      ]
    },
    {
      "id": "s43",
      "text": "Leo un libro en la playa.",
      "de": "Ich lese ein Buch am Strand.",
      "words": [
        "leer",
        "playa"
      ],
      "grammar": [
        "presente"
      ]
    },
    {
      "id": "s44",
      "text": "¿Qué hacés el fin de semana?",
      "de": "Was machst du am Wochenende?",
      "words": [
        "hacer",
        "fin_de_semana"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s45",
      "text": "El fin de semana vamos al río.",
      "de": "Am Wochenende fahren wir an den Fluss.",
      "words": [
        "fin_de_semana",
        "rio"
      ]
    },
    {
      "id": "s46",
      "text": "Estamos mirando el partido.",
      "de": "Wir schauen gerade das Spiel.",
      "words": [
        "mirar",
        "partido"
      ],
      "grammar": [
        "estar_gerundio"
      ]
    },
    {
      "id": "s47",
      "text": "Está todo muy tranquilo.",
      "de": "Es ist alles sehr ruhig.",
      "words": [
        "tranquilo",
        "muy"
      ]
    },
    {
      "id": "s48",
      "text": "Comemos afuera.",
      "de": "Wir essen draussen.",
      "words": [
        "afuera",
        "comer"
      ],
      "grammar": [
        "presente"
      ]
    },
    {
      "id": "s49",
      "text": "Mejor nos quedamos adentro.",
      "de": "Wir bleiben lieber drinnen.",
      "words": [
        "adentro",
        "mejor"
      ]
