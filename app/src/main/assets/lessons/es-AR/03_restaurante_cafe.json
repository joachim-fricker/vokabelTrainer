  "sentences": [
    {
      "id": "s01",
      "text": "Una mesa para dos, por favor.",
      "de": "Einen Tisch für zwei, bitte.",
      "words": [
        "mesa",
        "dos",
        "por_favor"
      ]
    },
    {
      "id": "s02",
      "text": "Tengo una reserva a las nueve.",
      "de": "Ich habe eine Reservierung um neun.",
      "words": [
        "reserva",
        "nueve"
      ]
    },
    {
      "id": "s03",
      "text": "¿Me traés la carta, por favor?",
      "de": "Bringst du mir bitte die Speisekarte?",
      "words": [
        "carta",
        "traer",
        "por_favor"
      ],
      "grammar": [
        "pedir_comida"
      ]
    },
    {
      "id": "s04",
      "text": "¿Qué plato me recomendás?",
      "de": "Welches Gericht empfiehlst du mir?",
      "words": [
        "plato",
        "recomendar"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s05",
      "text": "¿Tienen menú del día?",
      "de": "Habt ihr ein Tagesmenü?",
      "words": [
        "menu"
      ]
    },
    {
      "id": "s06",
      "text": "Quiero un bife de chorizo jugoso.",
      "de": "Ich möchte ein Rumpsteak, blutig.",
      "words": [
        "querer",
        "bife",
        "jugoso"
      ],
      "grammar": [
        "pedir_comida"
      ]
    },
    {
      "id": "s07",
      "text": "Para mí, una milanesa con papas fritas.",
      "de": "Für mich ein Schnitzel mit Pommes.",
      "words": [
        "milanesa",
        "con",
        "papas_fritas"
      ],
      "grammar": [
        "pedir_comida"
      ]
    },
    {
      "id": "s08",
      "text": "Dos empanadas de carne, por favor.",
      "de": "Zwei Empanadas mit Fleisch, bitte.",
      "words": [
        "empanada",
        "carne",
        "dos"
      ],
      "grammar": [
        "plural"
      ]
    },
    {
      "id": "s09",
      "text": "El bife bien cocido, por favor.",
      "de": "Das Steak bitte durchgebraten.",
      "words": [
        "bife",
        "bien_cocido"
      ],
      "grammar": [
        "articulos"
      ]
    },
    {
      "id": "s10",
      "text": "A punto, por favor.",
      "de": "Medium, bitte.",
      "words": [
        "a_punto"
      ]
    },
    {
      "id": "s11",
      "text": "Soy vegetariano.",
      "de": "Ich bin Vegetarier.",
      "words": [
        "vegetariano"
      ]
    },
    {
      "id": "s12",
      "text": "¿Tienen un plato vegetariano?",
      "de": "Habt ihr ein vegetarisches Gericht?",
      "words": [
        "plato",
        "vegetariano"
      ]
    },
    {
      "id": "s13",
      "text": "Una ensalada sin cebolla.",
      "de": "Einen Salat ohne Zwiebeln.",
      "words": [
        "ensalada",
        "sin"
      ]
    },
    {
      "id": "s14",
      "text": "Pollo con arroz.",
      "de": "Hähnchen mit Reis.",
      "words": [
        "pollo",
        "con",
        "arroz"
      ]
    },
    {
      "id": "s15",
      "text": "El pescado está muy rico.",
      "de": "Der Fisch ist sehr lecker.",
      "words": [
        "pescado",
        "muy",
        "rico"
      ]
    },
    {
      "id": "s16",
      "text": "¿Me traés un poco de pan?",
      "de": "Bringst du mir etwas Brot?",
      "words": [
        "traer",
        "pan",
        "un_poco"
      ],
      "grammar": [
        "pedir_comida"
      ]
    },
    {
      "id": "s17",
      "text": "Un choripán y una gaseosa.",
      "de": "Ein Choripán und eine Limo.",
      "words": [
        "choripan",
        "gaseosa",
        "uno"
      ]
    },
    {
      "id": "s18",
      "text": "Una pizza para llevar.",
      "de": "Eine Pizza zum Mitnehmen.",
      "words": [
        "pizza",
        "para_llevar"
      ]
    },
    {
      "id": "s19",
      "text": "¿Para comer acá o para llevar?",
      "de": "Zum Hieressen oder zum Mitnehmen?",
      "words": [
        "para_comer_aca",
        "para_llevar"
      ]
    },
    {
      "id": "s20",
      "text": "El domingo hacemos un asado.",
      "de": "Am Sonntag machen wir ein Asado.",
      "words": [
        "asado"
      ]
    },
