  "sentences": [
    {
      "id": "s01",
      "text": "Tengo una reserva a nombre de Fricker.",
      "de": "Ich habe eine Reservierung auf den Namen Fricker.",
      "words": [
        "tener",
        "reserva"
      ],
      "grammar": [
        "tener_hay"
      ]
    },
    {
      "id": "s02",
      "text": "¿A qué hora es el check-in?",
      "de": "Um wie viel Uhr ist der Check-in?",
      "words": [
        "check_in",
        "a_que_hora"
      ],
      "grammar": [
        "preguntas"
      ]
    },
    {
      "id": "s03",
      "text": "El check-out es a las diez.",
      "de": "Der Check-out ist um zehn.",
      "words": [
        "check_out",
        "diez"
      ]
    },
    {
      "id": "s04",
      "text": "¿Me muestra su pasaporte, por favor?",
      "de": "Zeigen Sie mir bitte Ihren Pass?",
      "words": [
        "pasaporte",
        "por_favor"
      ],
      "grammar": [
        "vos_usted"
      ]
    },
    {
      "id": "s05",
      "text": "Necesito el documento de todos los huéspedes.",
      "de": "Ich brauche den Ausweis aller Gäste.",
      "words": [
        "necesitar",
        "documento",
        "huesped"
      ],
      "grammar": [
        "necesitar"
      ]
    },
    {
      "id": "s06",
      "text": "¿Tienen una habitación doble?",
      "de": "Habt ihr ein Doppelzimmer?",
      "words": [
        "habitacion_doble",
        "tener"
      ],
      "grammar": [
        "tener_hay"
      ]
    },
    {
      "id": "s07",
      "text": "Quiero una habitación simple.",
      "de": "Ich möchte ein Einzelzimmer.",
      "words": [
        "habitacion_simple",
        "querer"
      ]
    },
    {
      "id": "s08",
      "text": "Me quedo tres noches.",
      "de": "Ich bleibe drei Nächte.",
      "words": [
        "quedarse",
        "tres"
      ]
    },
    {
      "id": "s09",
      "text": "¿Cuánto cuesta la noche?",
      "de": "Wie viel kostet die Nacht?",
      "words": [
        "cuanto",
        "noche"
      ]
    },
    {
      "id": "s10",
      "text": "¿El desayuno está incluido?",
      "de": "Ist das Frühstück inbegriffen?",
      "words": [
        "desayuno",
        "incluido"
      ]
    },
    {
      "id": "s11",
      "text": "Acá tiene la llave.",
      "de": "Hier haben Sie den Schlüssel.",
      "words": [
        "llave"
      ]
    },
    {
      "id": "s12",
      "text": "La habitación está en el tercer piso.",
      "de": "Das Zimmer ist im dritten Stock.",
      "words": [
        "habitacion",
        "piso"
      ]
    },
    {
      "id": "s13",
      "text": "¿Dónde está el ascensor?",
      "de": "Wo ist der Aufzug?",
      "words": [
        "donde",
        "ascensor"
      ],
      "grammar": [
        "preguntas"
      ]
    },
    {
      "id": "s14",
      "text": "La escalera está a la derecha.",
      "de": "Die Treppe ist rechts.",
      "words": [
        "escalera"
      ]
    },
    {
      "id": "s15",
      "text": "¿Cuál es la contraseña del wifi?",
      "de": "Wie lautet das WLAN-Passwort?",
      "words": [
        "cual",
        "contrasena",
        "wifi"
      ],
      "grammar": [
        "preguntas"
      ]
    },
    {
      "id": "s16",
      "text": "¿Hay wifi en la habitación?",
      "de": "Gibt es WLAN im Zimmer?",
      "words": [
        "hay",
        "wifi",
        "habitacion"
      ],
      "grammar": [
        "tener_hay"
      ]
    },
    {
      "id": "s17",
      "text": "¿El hotel tiene pileta?",
      "de": "Hat das Hotel einen Pool?",
      "words": [
        "hotel",
        "pileta",
        "tener"
      ],
      "grammar": [
        "tener_hay"
      ]
    },
    {
      "id": "s18",
      "text": "¿Hay estacionamiento?",
      "de": "Gibt es einen Parkplatz?",
      "words": [
        "hay",
        "estacionamiento"
      ],
      "grammar": [
        "tener_hay"
      ]
    },
    {
      "id": "s19",
      "text": "¿La habitación tiene caja fuerte?",
      "de": "Hat das Zimmer einen Safe?",
      "words": [
        "caja_fuerte",
        "habitacion"
      ],
      "grammar": [
        "tener_hay"
      ]
    },
    {
      "id": "s20",
      "text": "¿A qué hora es la limpieza?",
      "de": "Wann wird geputzt?",
      "words": [
        "limpieza",
        "a_que_hora"
      ]
    },
    {
      "id": "s21",
      "text": "¿Hay un lavadero cerca?",
      "de": "Gibt es eine Wäscherei in der Nähe?",
      "words": [
        "lavadero",
        "hay"
      ],
      "grammar": [
        "tener_hay"
      ]
    },
    {
      "id": "s22",
      "text": "¿Dónde hay un enchufe?",
      "de": "Wo gibt es eine Steckdose?",
      "words": [
        "donde",
        "enchufe",
        "hay"
      ],
      "grammar": [
        "preguntas"
      ]
    },
    {
      "id": "s23",
      "text": "Me olvidé el cargador.",
      "de": "Ich habe das Ladegerät vergessen.",
      "words": [
        "cargador"
      ]
    },
    {
      "id": "s24",
      "text": "La ducha no funciona.",
      "de": "Die Dusche funktioniert nicht.",
      "words": [
        "ducha",
        "funcionar",
        "no"
      ]
    },
    {
      "id": "s25",
      "text": "No hay agua caliente.",
      "de": "Es gibt kein warmes Wasser.",
      "words": [
        "agua_caliente",
        "hay",
        "no"
      ],
      "grammar": [
        "tener_hay"
      ]
    },
    {
      "id": "s26",
      "text": "El aire acondicionado está roto.",
      "de": "Die Klimaanlage ist kaputt.",
      "words": [
        "aire_acondicionado",
        "roto"
      ]
    },
    {
      "id": "s27",
      "text": "¿Funciona la calefacción?",
      "de": "Funktioniert die Heizung?",
      "words": [
        "calefaccion",
        "funcionar"
      ]
    },
    {
      "id": "s28",
      "text": "El ventilador hace mucho ruido.",
      "de": "Der Ventilator macht viel Lärm.",
      "words": [
        "ventilador"
      ]
    },
    {
      "id": "s29",
      "text": "Es un barrio muy ruidoso.",
      "de": "Es ist ein sehr lautes Viertel.",
      "words": [
        "ruidoso",
        "muy"
      ]
    },
    {
      "id": "s30",
      "text": "¿Me trae otra toalla, por favor?",
      "de": "Bringen Sie mir bitte noch ein Handtuch?",
      "words": [
        "toalla",
        "traer",
        "por_favor"
      ]
    },
    {
      "id": "s31",
      "text": "El baño está sucio.",
      "de": "Das Bad ist schmutzig.",
      "words": [
        "bano",
        "sucio"
      ]
    },
    {
      "id": "s32",
      "text": "El baño ya está limpio.",
      "de": "Das Bad ist jetzt sauber.",
      "words": [
        "bano",
        "limpio"
      ]
    },
    {
      "id": "s33",
      "text": "Necesito otra almohada.",
      "de": "Ich brauche noch ein Kopfkissen.",
      "words": [
        "almohada",
        "necesitar"
      ],
      "grammar": [
        "necesitar"
      ]
    },
    {
      "id": "s34",
      "text": "¿Me trae una frazada más?",
      "de": "Bringen Sie mir noch eine Decke?",
      "words": [
        "frazada",
        "traer"
      ]
    },
    {
      "id": "s35",
      "text": "La cama es muy cómoda.",
      "de": "Das Bett ist sehr bequem.",
      "words": [
        "cama",
        "muy"
      ]
    },
    {
      "id": "s36",
      "text": "¿Puedo cambiar de habitación?",
      "de": "Kann ich das Zimmer wechseln?",
      "words": [
        "cambiar",
        "habitacion"
      ]
    },
    {
      "id": "s37",
      "text": "Tenemos un problema con la ventana.",
