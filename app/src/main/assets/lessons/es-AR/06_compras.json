  "sentences": [
    {
      "id": "s01",
      "text": "¿Dónde hay un supermercado?",
      "de": "Wo gibt es einen Supermarkt?",
      "words": [
        "supermercado",
        "donde",
        "hay"
      ]
    },
    {
      "id": "s02",
      "text": "Voy al kiosco a comprar agua.",
      "de": "Ich gehe zum Kiosk, Wasser kaufen.",
      "words": [
        "kiosco",
        "comprar",
        "agua"
      ],
      "grammar": [
        "del_al"
      ]
    },
    {
      "id": "s03",
      "text": "El almacén de la esquina abre temprano.",
      "de": "Der Laden an der Ecke macht früh auf.",
      "words": [
        "almacen",
        "esquina",
        "temprano"
      ]
    },
    {
      "id": "s04",
      "text": "En la verdulería la fruta es más barata.",
      "de": "Im Obstladen ist das Obst günstiger.",
      "words": [
        "verduleria",
        "fruta",
        "mas"
      ],
      "grammar": [
        "comparativo"
      ]
    },
    {
      "id": "s05",
      "text": "Compro pan en la panadería.",
      "de": "Ich kaufe Brot in der Bäckerei.",
      "words": [
        "pan",
        "panaderia",
        "comprar"
      ]
    },
    {
      "id": "s06",
      "text": "En la carnicería venden muy buena carne.",
      "de": "In der Metzgerei verkaufen sie sehr gutes Fleisch.",
      "words": [
        "carniceria",
        "carne",
        "muy",
        "vender"
      ]
    },
    {
      "id": "s07",
      "text": "El domingo hay feria en la plaza.",
      "de": "Am Sonntag ist Markt auf dem Platz.",
      "words": [
        "feria",
        "plaza",
        "hay"
      ]
    },
    {
      "id": "s08",
      "text": "Vamos al shopping.",
      "de": "Gehen wir ins Einkaufszentrum.",
      "words": [
        "shopping",
        "ir"
      ],
      "grammar": [
        "del_al"
      ]
    },
    {
      "id": "s09",
      "text": "Este negocio cierra a las ocho.",
      "de": "Dieser Laden schliesst um acht.",
      "words": [
        "negocio",
        "este",
        "ocho"
      ],
      "grammar": [
        "demostrativos"
      ]
    },
    {
      "id": "s10",
      "text": "Un kilo de manzanas, por favor.",
      "de": "Ein Kilo Äpfel, bitte.",
      "words": [
        "kilo",
        "manzana",
        "por_favor"
      ]
    },
    {
      "id": "s11",
      "text": "Medio kilo de tomates.",
      "de": "Ein halbes Kilo Tomaten.",
      "words": [
        "medio",
        "kilo",
        "tomate"
      ]
    },
    {
      "id": "s12",
      "text": "Dos bananas y una naranja.",
      "de": "Zwei Bananen und eine Orange.",
      "words": [
        "banana",
        "naranja",
        "dos"
      ]
    },
    {
      "id": "s13",
      "text": "Un helado de frutilla.",
      "de": "Ein Erdbeereis.",
      "words": [
        "frutilla",
        "helado"
      ]
    },
    {
      "id": "s14",
      "text": "Un jugo de durazno.",
      "de": "Ein Pfirsichsaft.",
      "words": [
        "durazno",
        "jugo"
      ]
    },
    {
      "id": "s15",
      "text": "Una palta bien madura.",
      "de": "Eine schön reife Avocado.",
      "words": [
        "palta"
      ]
    },
    {
      "id": "s16",
      "text": "Un kilo de papa y una cebolla.",
      "de": "Ein Kilo Kartoffeln und eine Zwiebel.",
      "words": [
        "papa",
        "cebolla",
        "kilo"
      ]
    },
    {
      "id": "s17",
      "text": "Pan con manteca.",
      "de": "Brot mit Butter.",
      "words": [
        "pan",
        "manteca",
        "con"
      ]
    },
    {
      "id": "s18",
      "text": "Medio kilo de yerba, por favor.",
      "de": "Ein halbes Kilo Yerba, bitte.",
      "words": [
        "yerba",
        "medio",
        "kilo"
      ]
    },
    {
      "id": "s19",
      "text": "Un paquete de galletitas.",
      "de": "Eine Packung Kekse.",
      "words": [
        "galletitas"
      ]
    },
    {
      "id": "s20",
      "text": "¿Me das una bolsa?",
      "de": "Gibst du mir eine Tüte?",
      "words": [
        "bolsa"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s21",
      "text": "Busco una remera blanca.",
      "de": "Ich suche ein weisses T-Shirt.",
      "words": [
        "buscar",
        "remera",
        "blanco"
      ],
      "grammar": [
        "adjetivos"
      ]
    },
    {
      "id": "s22",
      "text": "¿Tenés este pantalón en negro?",
      "de": "Hast du diese Hose in Schwarz?",
      "words": [
        "pantalon",
        "este",
        "negro"
      ],
      "grammar": [
        "demostrativos"
      ]
    },
    {
      "id": "s23",
      "text": "Esa pollera es muy linda.",
      "de": "Der Rock da ist sehr hübsch.",
      "words": [
        "pollera",
        "ese",
        "lindo",
        "muy"
      ],
      "grammar": [
        "demostrativos"
      ]
    },
    {
      "id": "s24",
      "text": "Necesito una campera para el frío.",
      "de": "Ich brauche eine Jacke für die Kälte.",
      "words": [
        "campera",
        "necesitar"
      ]
    },
    {
      "id": "s25",
      "text": "Un buzo gris, talle M.",
      "de": "Ein grauer Pulli, Grösse M.",
      "words": [
        "buzo",
        "gris",
        "talle"
      ]
    },
    {
      "id": "s26",
      "text": "¿Qué talle usás?",
      "de": "Welche Grösse trägst du?",
      "words": [
        "talle",
        "que"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s27",
      "text": "¿Puedo probarme estas zapatillas?",
      "de": "Kann ich diese Turnschuhe anprobieren?",
      "words": [
        "probar",
        "zapatillas",
        "este"
      ],
      "grammar": [
        "demostrativos"
      ]
    },
    {
      "id": "s28",
      "text": "¿Lo puedo probar?",
      "de": "Kann ich es anprobieren?",
      "words": [
        "probar"
      ]
    },
    {
      "id": "s29",
      "text": "¿Dónde está el probador?",
      "de": "Wo ist die Umkleidekabine?",
      "words": [
        "probador",
        "donde"
      ]
    },
    {
      "id": "s30",
      "text": "Estos zapatos son muy chicos.",
      "de": "Diese Schuhe sind zu klein.",
      "words": [
        "zapatos",
        "chico",
        "muy",
        "este"
      ],
      "grammar": [
        "adjetivos"
      ]
    },
    {
      "id": "s31",
      "text": "¿Tiene un talle más grande?",
      "de": "Haben Sie eine Nummer grösser?",
      "words": [
