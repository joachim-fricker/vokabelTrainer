  "sentences": [
    {
      "id": "s01",
      "text": "Hoy es lunes.",
      "de": "Heute ist Montag.",
      "words": [
        "hoy",
        "lunes"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s02",
      "text": "Mañana es martes.",
      "de": "Morgen ist Dienstag.",
      "words": [
        "manana_adv",
        "martes"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s03",
      "text": "Ayer fue domingo.",
      "de": "Gestern war Sonntag.",
      "words": [
        "ayer",
        "domingo"
      ],
      "grammar": [
        "pasado"
      ]
    },
    {
      "id": "s04",
      "text": "El miércoles vamos al museo.",
      "de": "Am Mittwoch gehen wir ins Museum.",
      "words": [
        "miercoles",
        "museo"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s05",
      "text": "Los jueves hay feria.",
      "de": "Donnerstags ist Markt.",
      "words": [
        "jueves",
        "feria",
        "hay"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s06",
      "text": "El viernes a la noche salimos.",
      "de": "Freitagabend gehen wir aus.",
      "words": [
        "viernes",
        "noche",
        "salir"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s07",
      "text": "El sábado hacemos un asado.",
      "de": "Am Samstag machen wir Asado.",
      "words": [
        "sabado",
        "asado",
        "hacer"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s08",
      "text": "Me quedo una semana.",
      "de": "Ich bleibe eine Woche.",
      "words": [
        "semana",
        "quedarse"
      ]
    },
    {
      "id": "s09",
      "text": "¿Qué día es hoy?",
      "de": "Welcher Tag ist heute?",
      "words": [
        "dia",
        "hoy",
        "que"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s10",
      "text": "Llegamos el dos de enero.",
      "de": "Wir kommen am zweiten Januar an.",
      "words": [
        "enero",
        "dos",
        "llegar"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s11",
      "text": "En febrero hace mucho calor.",
      "de": "Im Februar ist es sehr heiss.",
      "words": [
        "febrero",
        "calor"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s12",
      "text": "Marzo es el mes de la vendimia en Mendoza.",
      "de": "Der März ist in Mendoza der Monat der Weinlese.",
      "words": [
        "marzo",
        "mes"
      ]
    },
    {
      "id": "s13",
      "text": "En abril empieza el otoño.",
      "de": "Im April beginnt der Herbst.",
      "words": [
        "abril",
        "empezar"
      ]
    },
    {
      "id": "s14",
      "text": "El veinticinco de mayo es feriado.",
      "de": "Der 25. Mai ist ein Feiertag.",
      "words": [
        "mayo",
        "feriado"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s15",
      "text": "En junio y julio es invierno.",
      "de": "Im Juni und Juli ist Winter.",
      "words": [
        "junio",
        "julio",
        "invierno"
      ]
    },
    {
      "id": "s16",
      "text": "En agosto hace frío.",
      "de": "Im August ist es kalt.",
      "words": [
        "agosto",
        "frio"
      ],
      "grammar": [
        "clima"
      ]
    },
    {
      "id": "s17",
      "text": "Mi cumpleaños es en septiembre.",
      "de": "Mein Geburtstag ist im September.",
      "words": [
        "cumpleanos",
        "septiembre",
        "mi"
      ]
    },
    {
      "id": "s18",
      "text": "En octubre vuelvo a Alemania.",
      "de": "Im Oktober fahre ich nach Deutschland zurück.",
      "words": [
        "octubre",
        "volver",
        "alemania"
      ]
    },
    {
      "id": "s19",
      "text": "Viajo en noviembre.",
      "de": "Ich reise im November.",
      "words": [
        "noviembre"
      ]
    },
    {
      "id": "s20",
      "text": "En diciembre empieza el verano.",
      "de": "Im Dezember beginnt der Sommer.",
      "words": [
        "diciembre",
        "verano",
        "empezar"
      ]
    },
    {
      "id": "s21",
      "text": "¿Qué fecha es hoy?",
      "de": "Welches Datum ist heute?",
      "words": [
        "fecha",
        "hoy"
      ],
      "grammar": [
        "fechas"
      ]
    },
    {
      "id": "s22",
      "text": "Nos vemos pasado mañana.",
      "de": "Wir sehen uns übermorgen.",
      "words": [
        "pasado_manana",
        "nos_vemos"
      ]
    },
    {
      "id": "s23",
      "text": "Siempre tomo mate a la mañana.",
      "de": "Ich trinke morgens immer Mate.",
      "words": [
        "siempre",
        "mate",
        "tomar"
      ]
    },
    {
      "id": "s24",
      "text": "Nunca como carne.",
      "de": "Ich esse nie Fleisch.",
      "words": [
        "nunca",
        "carne",
        "comer"
      ]
    },
    {
      "id": "s25",
      "text": "A veces duermo la siesta.",
      "de": "Manchmal mache ich Mittagsschlaf.",
      "words": [
        "a_veces",
        "dormir",
        "siesta"
      ],
      "grammar": [
        "verbos_irregulares"
      ]
    },
    {
      "id": "s26",
      "text": "Trabajo todos los días.",
      "de": "Ich arbeite jeden Tag.",
      "words": [
        "todos_los_dias",
        "trabajar"
      ]
    },
    {
      "id": "s27",
      "text": "Primero desayuno y después me ducho.",
      "de": "Zuerst frühstücke ich und danach dusche ich.",
      "words": [
        "desayunar",
        "despues",
        "ducharse"
      ]
    },
    {
      "id": "s28",
      "text": "Antes de salir, cierro la puerta.",
      "de": "Bevor ich gehe, schliesse ich die Tür.",
      "words": [
        "antes",
        "salir",
        "puerta"
      ]
    },
    {
      "id": "s29",
      "text": "Ya terminé.",
      "de": "Ich bin schon fertig.",
      "words": [
        "ya",
        "terminar"
      ],
      "grammar": [
        "pasado"
      ]
    },
    {
      "id": "s30",
      "text": "Todavía no sé.",
      "de": "Ich weiss es noch nicht.",
      "words": [
        "todavia",
        "saber",
        "no"
      ],
      "grammar": [
        "verbos_irregulares"
      ]
    },
    {
      "id": "s31",
      "text": "Me levanto a las siete.",
      "de": "Ich stehe um sieben auf.",
      "words": [
        "levantarse",
        "siete"
      ]
    },
    {
      "id": "s32",
      "text": "¿A qué hora te levantás?",
      "de": "Um wie viel Uhr stehst du auf?",
      "words": [
        "levantarse",
        "a_que_hora"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s33",
      "text": "Me acuesto tarde.",
      "de": "Ich gehe spät ins Bett.",
      "words": [
        "acostarse",
        "tarde"
      ]
    },
    {
      "id": "s34",
      "text": "Dormí muy bien.",
      "de": "Ich habe sehr gut geschlafen.",
      "words": [
        "dormir",
        "bien",
        "muy"
      ],
      "grammar": [
        "pasado"
      ]
    },
    {
      "id": "s35",
      "text": "¿Dormiste bien?",
      "de": "Hast du gut geschlafen?",
      "words": [
        "dormir",
        "bien"
      ],
      "grammar": [
        "pasado"
      ]
    },
    {
      "id": "s36",
      "text": "Hoy cocino yo.",
      "de": "Heute koche ich.",
      "words": [
        "cocinar",
        "hoy",
        "yo"
      ]
    },
    {
      "id": "s37",
      "text": "Tengo que limpiar la casa.",
      "de": "Ich muss das Haus putzen.",
      "words": [
        "limpiar",
        "casa",
        "tener_que"
      ],
      "grammar": [
        "tener_que"
      ]
    },
    {
      "id": "s38",
      "text": "¿Dónde puedo lavar la ropa?",
      "de": "Wo kann ich Wäsche waschen?",
      "words": [
        "lavar",
        "ropa",
        "poder"
      ],
      "grammar": [
        "verbos_irregulares"
      ]
    },
    {
      "id": "s39",
      "text": "No voy a poder ir.",
      "de": "Ich werde nicht kommen können.",
      "words": [
        "poder",
        "ir"
      ],
      "grammar": [
        "ir_a"
      ]
    },
    {
      "id": "s40",
      "text": "¿Sabés dónde queda?",
      "de": "Weisst du, wo das ist?",
      "words": [
        "saber",
        "donde"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s41",
      "text": "¿Qué dijiste?",
      "de": "Was hast du gesagt?",
      "words": [
        "decir",
        "que"
      ],
      "grammar": [
        "pasado"
      ]
    },
    {
      "id": "s42",
      "text": "¿Cómo se dice en español?",
      "de": "Wie sagt man das auf Spanisch?",
      "words": [
        "decir",
        "como",
        "espanol"
      ]
    },
    {
      "id": "s43",
      "text": "La clase empieza a las nueve.",
      "de": "Der Unterricht beginnt um neun.",
      "words": [
        "empezar",
