  "sentences": [
    {
      "id": "s01",
      "text": "Me duele la cabeza.",
      "de": "Ich habe Kopfschmerzen.",
      "words": [
        "doler",
        "cabeza"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s02",
      "text": "Me duele mucho la panza.",
      "de": "Mir tut der Bauch sehr weh.",
      "words": [
        "doler",
        "panza",
        "mucho"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s03",
      "text": "Me duele la garganta.",
      "de": "Ich habe Halsschmerzen.",
      "words": [
        "garganta",
        "doler"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s04",
      "text": "Me duele el pie derecho.",
      "de": "Mir tut der rechte Fuss weh.",
      "words": [
        "pie",
        "doler"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s05",
      "text": "Me duele la pierna.",
      "de": "Mir tut das Bein weh.",
      "words": [
        "pierna",
        "doler"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s06",
      "text": "Tengo dolor de espalda.",
      "de": "Ich habe Rückenschmerzen.",
      "words": [
        "dolor",
        "espalda"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s07",
      "text": "Tengo dolor de muela.",
      "de": "Ich habe Zahnschmerzen.",
      "words": [
        "dolor",
        "muela"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s08",
      "text": "Me lastimé la mano.",
      "de": "Ich habe mich an der Hand verletzt.",
      "words": [
        "mano"
      ]
    },
    {
      "id": "s09",
      "text": "Me duele el brazo.",
      "de": "Mir tut der Arm weh.",
      "words": [
        "brazo",
        "doler"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s10",
      "text": "Tengo algo en el ojo.",
      "de": "Ich habe etwas im Auge.",
      "words": [
        "ojo"
      ]
    },
    {
      "id": "s11",
      "text": "Me duele el oído.",
      "de": "Ich habe Ohrenschmerzen.",
      "words": [
        "oido",
        "doler"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s12",
      "text": "Se me rompió un diente.",
      "de": "Mir ist ein Zahn abgebrochen.",
      "words": [
        "diente"
      ]
    },
    {
      "id": "s13",
      "text": "Tengo un dolor fuerte en el pecho.",
      "de": "Ich habe starke Schmerzen in der Brust.",
      "words": [
        "dolor",
        "pecho"
      ]
    },
    {
      "id": "s14",
      "text": "Me caí y me duele la rodilla.",
      "de": "Ich bin gestürzt und mir tut das Knie weh.",
      "words": [
        "rodilla",
        "doler"
      ],
      "grammar": [
        "doler"
      ]
    },
    {
      "id": "s15",
      "text": "Tengo fiebre.",
      "de": "Ich habe Fieber.",
      "words": [
        "fiebre"
      ],
      "grammar": [
        "tener_hambre"
      ]
    },
    {
      "id": "s16",
      "text": "Tengo tos y estoy resfriado.",
      "de": "Ich habe Husten und bin erkältet.",
      "words": [
        "tos"
      ],
      "grammar": [
        "estar_estado"
      ]
    },
    {
      "id": "s17",
      "text": "Es solo un resfrío.",
      "de": "Es ist nur eine Erkältung.",
      "words": [
        "resfrio"
      ]
    },
    {
      "id": "s18",
      "text": "Creo que tengo gripe.",
      "de": "Ich glaube, ich habe die Grippe.",
      "words": [
        "gripe"
      ]
    },
    {
      "id": "s19",
      "text": "Tengo diarrea.",
      "de": "Ich habe Durchfall.",
      "words": [
        "diarrea"
      ]
    },
    {
      "id": "s20",
      "text": "Tengo náuseas.",
      "de": "Mir ist übel.",
      "words": [
        "nauseas"
      ]
    },
    {
      "id": "s21",
      "text": "Estoy mareado.",
      "de": "Mir ist schwindlig.",
      "words": [
        "mareado"
      ],
      "grammar": [
        "estar_estado"
      ]
    },
    {
      "id": "s22",
      "text": "Estoy enfermo.",
      "de": "Ich bin krank.",
      "words": [
        "enfermo"
      ],
      "grammar": [
        "estar_estado"
      ]
    },
    {
      "id": "s23",
      "text": "Estoy muy cansado.",
      "de": "Ich bin sehr müde.",
      "words": [
        "cansado",
        "muy"
      ],
      "grammar": [
        "estar_estado"
      ]
    },
    {
      "id": "s24",
      "text": "Me siento mal.",
      "de": "Ich fühle mich schlecht.",
      "words": [
        "sentirse",
        "mal"
      ]
    },
    {
      "id": "s25",
      "text": "Mi mujer está embarazada.",
      "de": "Meine Frau ist schwanger.",
      "words": [
        "embarazada"
      ],
      "grammar": [
        "estar_estado"
      ]
    },
    {
      "id": "s26",
      "text": "Es una herida pequeña.",
      "de": "Es ist eine kleine Wunde.",
      "words": [
        "herida"
      ]
    },
    {
      "id": "s27",
      "text": "Tengo una quemadura de sol.",
      "de": "Ich habe einen Sonnenbrand.",
      "words": [
        "quemadura"
      ]
    },
    {
      "id": "s28",
      "text": "Es una picadura de mosquito.",
      "de": "Das ist ein Mückenstich.",
      "words": [
        "picadura"
      ]
    },
    {
      "id": "s29",
      "text": "Tengo alergia a la penicilina.",
      "de": "Ich bin gegen Penicillin allergisch.",
      "words": [
        "alergia"
      ]
    },
    {
      "id": "s30",
      "text": "Necesito un médico.",
      "de": "Ich brauche einen Arzt.",
      "words": [
        "medico",
        "necesitar"
      ]
    },
    {
      "id": "s31",
      "text": "¿Dónde está el hospital?",
      "de": "Wo ist das Krankenhaus?",
      "words": [
        "hospital",
        "donde"
      ]
    },
    {
      "id": "s32",
      "text": "Tenemos que ir a la guardia.",
      "de": "Wir müssen in die Notaufnahme.",
      "words": [
        "guardia",
        "tener_que"
      ],
      "grammar": [
        "tener_que"
      ]
    },
    {
      "id": "s33",
      "text": "¿Hay una farmacia cerca?",
      "de": "Gibt es eine Apotheke in der Nähe?",
      "words": [
        "farmacia",
        "cerca",
        "hay"
      ]
    },
    {
      "id": "s34",
      "text": "¿Tiene algo para el dolor de cabeza?",
      "de": "Haben Sie etwas gegen Kopfschmerzen?",
      "words": [
        "dolor",
        "cabeza"
      ]
    },
    {
      "id": "s35",
      "text": "Tomá este remedio dos veces por día.",
      "de": "Nimm dieses Medikament zweimal am Tag.",
      "words": [
        "remedio",
        "tomar",
        "dos"
      ],
      "grammar": [
        "imperativo"
      ]
    },
    {
      "id": "s36",
      "text": "Una pastilla cada ocho horas.",
      "de": "Eine Tablette alle acht Stunden.",
      "words": [
        "pastilla",
        "ocho"
      ]
    },
    {
      "id": "s37",
      "text": "¿Necesito receta?",
      "de": "Brauche ich ein Rezept?",
      "words": [
        "receta",
        "necesitar"
      ]
    },
    {
      "id": "s38",
      "text": "Quiero sacar un turno.",
      "de": "Ich möchte einen Termin vereinbaren.",
      "words": [
        "turno",
        "querer"
      ]
    },
    {
      "id": "s39",
      "text": "¿Tenés seguro de viaje?",
      "de": "Hast du eine Reiseversicherung?",
      "words": [
        "seguro"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
