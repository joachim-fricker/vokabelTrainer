  "sentences": [
    {
      "id": "s01",
      "text": "¿Dónde está la parada del colectivo?",
      "de": "Wo ist die Bushaltestelle?",
      "words": [
        "donde",
        "parada",
        "colectivo"
      ],
      "grammar": [
        "del_al"
      ]
    },
    {
      "id": "s02",
      "text": "¿Qué colectivo va al centro?",
      "de": "Welcher Bus fährt ins Zentrum?",
      "words": [
        "colectivo",
        "ir",
        "centro"
      ],
      "grammar": [
        "del_al"
      ]
    },
    {
      "id": "s03",
      "text": "Necesito cargar la SUBE.",
      "de": "Ich muss die SUBE aufladen.",
      "words": [
        "sube",
        "necesitar"
      ]
    },
    {
      "id": "s04",
      "text": "¿Dónde compro la SUBE?",
      "de": "Wo kaufe ich die SUBE?",
      "words": [
        "sube",
        "donde"
      ]
    },
    {
      "id": "s05",
      "text": "Vamos en subte.",
      "de": "Wir fahren mit der U-Bahn.",
      "words": [
        "subte",
        "ir"
      ],
      "grammar": [
        "del_al"
      ]
    },
    {
      "id": "s06",
      "text": "Voy a tomar un taxi.",
      "de": "Ich nehme ein Taxi.",
      "words": [
        "taxi",
        "tomar",
        "ir"
      ],
      "grammar": [
        "ir_a"
      ]
    },
    {
      "id": "s07",
      "text": "¿Me pedís un remís para las seis?",
      "de": "Bestellst du mir einen Remís für sechs Uhr?",
      "words": [
        "remis",
        "seis",
        "pedir"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s08",
      "text": "El tren sale a las ocho.",
      "de": "Der Zug fährt um acht.",
      "words": [
        "tren",
        "ocho",
        "salir"
      ]
    },
    {
      "id": "s09",
      "text": "Un pasaje a Córdoba, ida y vuelta.",
      "de": "Eine Fahrkarte nach Córdoba, hin und zurück.",
      "words": [
        "pasaje",
        "ida_y_vuelta"
      ]
    },
    {
      "id": "s10",
      "text": "¿A qué hora sale el micro?",
      "de": "Wann fährt der Fernbus?",
      "words": [
        "micro",
        "a_que_hora",
        "salir"
      ]
    },
    {
      "id": "s11",
      "text": "¿De qué terminal sale?",
      "de": "Von welchem Busbahnhof fährt er?",
      "words": [
        "terminal",
        "que",
        "salir"
      ]
    },
    {
      "id": "s12",
      "text": "El micro tiene una demora de una hora.",
      "de": "Der Bus hat eine Stunde Verspätung.",
      "words": [
        "micro",
        "demora",
        "hora"
      ]
    },
    {
      "id": "s13",
      "text": "¿Este asiento está libre?",
      "de": "Ist dieser Platz frei?",
      "words": [
        "asiento",
        "libre"
      ]
    },
    {
      "id": "s14",
      "text": "El colectivo está lleno.",
      "de": "Der Bus ist voll.",
      "words": [
        "colectivo",
        "lleno"
      ]
    },
    {
      "id": "s15",
      "text": "¿Es un vuelo directo?",
      "de": "Ist es ein Direktflug?",
      "words": [
        "vuelo",
        "directo"
      ]
    },
    {
      "id": "s16",
      "text": "¿Cómo llego al aeropuerto?",
      "de": "Wie komme ich zum Flughafen?",
      "words": [
        "como",
        "aeropuerto",
        "llegar"
      ],
      "grammar": [
        "del_al"
      ]
    },
    {
      "id": "s17",
      "text": "El avión sale a las once.",
      "de": "Das Flugzeug fliegt um elf.",
      "words": [
        "avion",
        "once",
        "salir"
      ]
    },
    {
      "id": "s18",
      "text": "Mi valija no llegó.",
      "de": "Mein Koffer ist nicht angekommen.",
      "words": [
        "valija",
        "no",
        "llegar"
      ]
    },
    {
      "id": "s19",
      "text": "Llevo solo una mochila.",
      "de": "Ich habe nur einen Rucksack dabei.",
      "words": [
        "mochila"
      ]
    },
    {
      "id": "s20",
      "text": "¿Dónde retiro el equipaje?",
      "de": "Wo hole ich das Gepäck ab?",
      "words": [
        "equipaje",
        "donde"
      ]
    },
    {
      "id": "s21",
      "text": "¿Dónde está la salida?",
      "de": "Wo ist der Ausgang?",
      "words": [
        "salida",
        "donde"
      ]
    },
    {
      "id": "s22",
      "text": "La llegada es a las tres.",
      "de": "Die Ankunft ist um drei.",
      "words": [
        "llegada",
        "tres"
      ]
    },
    {
      "id": "s23",
      "text": "¿Cuál es la próxima estación?",
      "de": "Was ist die nächste Station?",
      "words": [
        "estacion",
        "proximo",
        "cual"
      ]
    },
    {
      "id": "s24",
      "text": "¿Dónde tengo que bajar?",
      "de": "Wo muss ich aussteigen?",
      "words": [
        "bajar",
        "donde"
      ]
    },
    {
      "id": "s25",
      "text": "Hay que subir por adelante.",
      "de": "Man steigt vorne ein.",
      "words": [
        "subir"
      ]
    },
    {
      "id": "s26",
      "text": "Esperá acá, por favor.",
      "de": "Warte bitte hier.",
      "words": [
        "esperar",
        "aca"
      ],
      "grammar": [
        "imperativo"
      ]
    },
    {
      "id": "s27",
      "text": "Es fácil perderse en el centro.",
      "de": "Im Zentrum verirrt man sich leicht.",
      "words": [
        "perderse",
        "centro"
      ]
    },
    {
      "id": "s28",
      "text": "Seguí derecho dos cuadras.",
      "de": "Geh zwei Blocks geradeaus.",
      "words": [
        "seguir",
        "derecho",
        "cuadra",
        "dos"
      ],
      "grammar": [
        "imperativo"
      ]
    },
    {
      "id": "s29",
      "text": "Doblá a la derecha en la esquina.",
      "de": "Bieg an der Ecke rechts ab.",
      "words": [
        "doblar",
        "derecha",
        "esquina"
      ],
      "grammar": [
        "imperativo"
      ]
    },
    {
      "id": "s30",
      "text": "Después doblá a la izquierda.",
      "de": "Danach bieg links ab.",
      "words": [
        "doblar",
        "izquierda"
      ],
      "grammar": [
        "imperativo"
      ]
    },
    {
      "id": "s31",
      "text": "Cruzá la calle en el semáforo.",
      "de": "Überquer die Strasse an der Ampel.",
      "words": [
        "cruzar",
        "calle",
        "semaforo"
      ],
      "grammar": [
        "imperativo"
      ]
    },
    {
      "id": "s32",
      "text": "Está en la avenida, enfrente de la plaza.",
      "de": "Es ist an der Hauptstrasse, gegenüber vom Platz.",
      "words": [
        "avenida",
        "enfrente",
        "plaza"
      ]
    },
    {
      "id": "s33",
      "text": "El banco está al lado de la farmacia.",
      "de": "Die Bank ist neben der Apotheke.",
      "words": [
        "al_lado"
      ]
    },
    {
      "id": "s34",
      "text": "Está entre el hotel y la plaza.",
      "de": "Es ist zwischen dem Hotel und dem Platz.",
      "words": [
        "entre",
        "hotel",
        "plaza"
      ]
    },
    {
      "id": "s35",
      "text": "¿Está cerca o lejos?",
      "de": "Ist es nah oder weit?",
      "words": [
        "cerca",
        "lejos"
      ]
    },
    {
      "id": "s36",
      "text": "Está muy cerca, a tres cuadras.",
      "de": "Es ist ganz nah, drei Blocks entfernt.",
      "words": [
        "cerca",
        "cuadra",
        "tres",
        "muy"
      ]
    },
    {
      "id": "s37",
      "text": "La plaza está a una cuadra.",
      "de": "Der Platz ist einen Block entfernt.",
      "words": [
        "cuadra",
        "plaza"
      ]
    },
    {
      "id": "s38",
      "text": "Es lejos, mejor tomá un taxi.",
