  "sentences": [
    {
      "id": "s01",
      "text": "¿Cuánto cuesta?",
      "de": "Wie viel kostet das?",
      "words": [
        "cuanto",
        "costar"
      ]
    },
    {
      "id": "s02",
      "text": "¿Cuánto es?",
      "de": "Wie viel macht das?",
      "words": [
        "cuanto"
      ]
    },
    {
      "id": "s03",
      "text": "Son veinte pesos.",
      "de": "Das macht zwanzig Pesos.",
      "words": [
        "veinte",
        "peso"
      ]
    },
    {
      "id": "s04",
      "text": "Es muy caro.",
      "de": "Das ist sehr teuer.",
      "words": [
        "caro"
      ]
    },
    {
      "id": "s05",
      "text": "Es barato.",
      "de": "Das ist günstig.",
      "words": [
        "barato"
      ]
    },
    {
      "id": "s06",
      "text": "¿Puedo pagar con tarjeta?",
      "de": "Kann ich mit Karte bezahlen?",
      "words": [
        "pagar",
        "tarjeta"
      ]
    },
    {
      "id": "s07",
      "text": "Solo efectivo, por favor.",
      "de": "Nur bar, bitte.",
      "words": [
        "efectivo",
        "por_favor"
      ]
    },
    {
      "id": "s08",
      "text": "¿Hay descuento en efectivo?",
      "de": "Gibt es Rabatt bei Barzahlung?",
      "words": [
        "descuento",
        "efectivo"
      ]
    },
    {
      "id": "s09",
      "text": "¿Dónde hay un cajero automático?",
      "de": "Wo gibt es einen Geldautomaten?",
      "words": [
        "cajero",
        "uno"
      ]
    },
    {
      "id": "s10",
      "text": "No tengo plata.",
      "de": "Ich habe kein Geld.",
      "words": [
        "no",
        "plata"
      ],
      "grammar": [
        "negacion"
      ]
    },
    {
      "id": "s11",
      "text": "Necesito cambiar dólares.",
      "de": "Ich muss Dollar wechseln.",
      "words": [
        "cambiar",
        "dolar"
      ]
    },
    {
      "id": "s12",
      "text": "¿Tenés vuelto de mil?",
      "de": "Hast du Wechselgeld für tausend?",
      "words": [
        "vuelto",
        "mil"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s13",
      "text": "Acá está el vuelto.",
      "de": "Hier ist das Wechselgeld.",
      "words": [
        "vuelto"
      ]
    },
    {
      "id": "s14",
      "text": "Un billete de cien pesos.",
      "de": "Ein Hundert-Peso-Schein.",
      "words": [
        "billete",
        "cien",
        "uno"
      ]
    },
    {
      "id": "s15",
      "text": "No tengo monedas.",
      "de": "Ich habe keine Münzen.",
      "words": [
        "moneda",
        "no"
      ],
      "grammar": [
        "negacion"
      ]
    },
    {
      "id": "s16",
      "text": "El precio es de quinientos pesos.",
      "de": "Der Preis beträgt fünfhundert Pesos.",
      "words": [
        "precio",
        "quinientos"
      ]
    },
    {
      "id": "s17",
      "text": "Son doscientos pesos.",
      "de": "Das macht zweihundert Pesos.",
      "words": [
        "doscientos"
      ],
      "grammar": [
        "zahlen_geschlecht"
      ]
    },
    {
      "id": "s18",
      "text": "Cuesta un millón de pesos.",
      "de": "Es kostet eine Million Pesos.",
      "words": [
        "costar",
        "millon"
      ],
      "grammar": [
        "grosse_zahlen"
      ]
    },
    {
      "id": "s19",
      "text": "Tres mil quinientos.",
      "de": "Dreitausendfünfhundert.",
      "words": [
        "tres",
        "mil",
        "quinientos"
      ],
      "grammar": [
        "grosse_zahlen"
      ]
    },
    {
      "id": "s20",
      "text": "Una cerveza y dos empanadas.",
      "de": "Ein Bier und zwei Empanadas.",
      "words": [
        "uno",
        "dos"
      ],
      "grammar": [
        "zahlen_geschlecht"
      ]
    },
    {
      "id": "s21",
      "text": "Uno, dos, tres, cuatro, cinco.",
      "de": "Eins, zwei, drei, vier, fünf.",
      "words": [
        "uno",
        "dos",
        "tres",
        "cuatro",
        "cinco"
      ]
    },
    {
      "id": "s22",
      "text": "Seis, siete, ocho, nueve, diez.",
      "de": "Sechs, sieben, acht, neun, zehn.",
      "words": [
        "seis",
        "siete",
        "ocho",
        "nueve",
        "diez"
      ]
    },
    {
      "id": "s23",
      "text": "Mi número es cero, once, doce.",
      "de": "Meine Nummer ist null, elf, zwölf.",
      "words": [
        "cero",
        "once",
        "doce"
      ]
    },
    {
      "id": "s24",
      "text": "Quince minutos.",
      "de": "Fünfzehn Minuten.",
      "words": [
        "quince",
        "minuto"
      ]
    },
    {
      "id": "s25",
      "text": "Treinta, cuarenta, cincuenta.",
      "de": "Dreissig, vierzig, fünfzig.",
      "words": [
        "treinta",
        "cuarenta",
        "cincuenta"
      ]
    },
    {
      "id": "s26",
      "text": "¿Qué hora es?",
      "de": "Wie spät ist es?",
      "words": [
        "que_hora"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s27",
      "text": "Es la una.",
      "de": "Es ist ein Uhr.",
      "words": [
        "uno"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s28",
      "text": "Son las dos en punto.",
      "de": "Es ist genau zwei Uhr.",
      "words": [
        "dos",
        "en_punto"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s29",
      "text": "Son las tres y media.",
      "de": "Es ist halb vier.",
      "words": [
        "tres",
        "y_media"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s30",
      "text": "Son las cuatro y cuarto.",
      "de": "Es ist Viertel nach vier.",
      "words": [
        "cuatro",
        "y_cuarto"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s31",
      "text": "Son las ocho menos cuarto.",
      "de": "Es ist Viertel vor acht.",
      "words": [
        "ocho",
        "menos_cuarto"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s32",
      "text": "¿A qué hora abre?",
      "de": "Um wie viel Uhr macht es auf?",
      "words": [
        "a_que_hora"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s33",
      "text": "A las nueve de la mañana.",
      "de": "Um neun Uhr morgens.",
      "words": [
        "nueve",
        "manana_m"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s34",
      "text": "A las cinco de la tarde.",
      "de": "Um fünf Uhr nachmittags.",
      "words": [
        "cinco",
        "tarde_n"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s35",
      "text": "A las diez de la noche.",
      "de": "Um zehn Uhr abends.",
      "words": [
        "diez",
        "noche"
      ],
      "grammar": [
        "uhrzeit"
      ]
    },
    {
      "id": "s36",
      "text": "Al mediodía está cerrado.",
      "de": "Mittags ist geschlossen.",
      "words": [
        "mediodia",
        "cerrado"
      ]
    },
    {
      "id": "s37",
      "text": "Está abierto hasta la medianoche.",
      "de": "Es ist bis Mitternacht geöffnet.",
      "words": [
        "abierto",
        "medianoche"
      ]
    },
    {
      "id": "s38",
      "text": "Ahora está cerrado.",
      "de": "Jetzt ist geschlossen.",
      "words": [
        "ahora",
        "cerrado"
      ]
    },
    {
      "id": "s39",
      "text": "Es temprano.",
      "de": "Es ist früh.",
      "words": [
        "temprano"
      ]
    },
    {
      "id": "s40",
      "text": "Ya es muy tarde.",
      "de": "Es ist schon sehr spät.",
      "words": [
        "tarde"
      ]
    },
    {
      "id": "s41",
      "text": "Una hora, más o menos.",
      "de": "Ungefähr eine Stunde.",
      "words": [
        "hora",
        "mas_o_menos",
        "uno"
      ]
    },
    {
      "id": "s42",
      "text": "Llego en diez minutos.",
      "de": "Ich komme in zehn Minuten.",
      "words": [
        "diez",
        "minuto"
      ]
    },
    {
      "id": "s43",
      "text": "¿Cuánto cuesta en dólares?",
      "de": "Wie viel kostet es in Dollar?",
      "words": [
        "cuanto",
        "costar"
      ]
    },
