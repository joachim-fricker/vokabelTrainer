  "sentences": [
    {
      "id": "s01",
      "text": "¿De dónde sos?",
      "de": "Woher kommst du?",
      "words": [
        "de_donde",
        "ser"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s02",
      "text": "Soy de Alemania.",
      "de": "Ich komme aus Deutschland.",
      "words": [
        "ser",
        "alemania"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s03",
      "text": "Soy alemán, de Múnich.",
      "de": "Ich bin Deutscher, aus München.",
      "words": [
        "aleman",
        "ser"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s04",
      "text": "¿Vos sos argentino?",
      "de": "Bist du Argentinier?",
      "words": [
        "argentino",
        "vos",
        "ser"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s05",
      "text": "Sí, soy porteño.",
      "de": "Ja, ich bin aus Buenos Aires.",
      "words": [
        "porteno",
        "si"
      ]
    },
    {
      "id": "s06",
      "text": "Argentina es un país enorme.",
      "de": "Argentinien ist ein riesiges Land.",
      "words": [
        "argentina",
        "pais"
      ]
    },
    {
      "id": "s07",
      "text": "¿En qué ciudad vivís?",
      "de": "In welcher Stadt wohnst du?",
      "words": [
        "ciudad",
        "vivir"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s08",
      "text": "Vivo en un pueblo chico.",
      "de": "Ich wohne in einem kleinen Dorf.",
      "words": [
        "pueblo",
        "vivir",
        "chico"
      ]
    },
    {
      "id": "s09",
      "text": "Mi barrio es muy tranquilo.",
      "de": "Mein Viertel ist sehr ruhig.",
      "words": [
        "barrio",
        "mi",
        "muy"
      ],
      "grammar": [
        "posesivos"
      ]
    },
    {
      "id": "s10",
      "text": "¿Sos extranjero?",
      "de": "Bist du Ausländer?",
      "words": [
        "extranjero",
        "ser"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s11",
      "text": "Estoy de vacaciones.",
      "de": "Ich bin im Urlaub.",
      "words": [
        "vacaciones",
        "estar"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s12",
      "text": "Estamos en Buenos Aires por dos semanas.",
      "de": "Wir sind für zwei Wochen in Buenos Aires.",
      "words": [
        "estar",
        "dos"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s13",
      "text": "Es mi primera vez en Argentina.",
      "de": "Ich bin zum ersten Mal in Argentinien.",
      "words": [
        "primera_vez",
        "argentina",
        "mi"
      ]
    },
    {
      "id": "s14",
      "text": "Este es mi esposo.",
      "de": "Das ist mein Mann.",
      "words": [
        "esposo",
        "mi"
      ],
      "grammar": [
        "posesivos"
      ]
    },
    {
      "id": "s15",
      "text": "Tengo un hijo y una hija.",
      "de": "Ich habe einen Sohn und eine Tochter.",
      "words": [
        "hijo",
        "hija"
      ]
    },
    {
      "id": "s16",
      "text": "¿Estás casado?",
      "de": "Bist du verheiratet?",
      "words": [
        "casado",
        "estar"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s17",
      "text": "No, soy soltero.",
      "de": "Nein, ich bin ledig.",
      "words": [
        "soltero",
        "no",
        "ser"
      ]
    },
    {
      "id": "s18",
      "text": "Mi familia vive en Alemania.",
      "de": "Meine Familie lebt in Deutschland.",
      "words": [
        "familia",
        "mi",
        "alemania",
        "vivir"
      ],
      "grammar": [
        "posesivos"
      ]
    },
    {
      "id": "s19",
      "text": "Mi padre es ingeniero.",
      "de": "Mein Vater ist Ingenieur.",
      "words": [
        "padre",
        "ingeniero",
        "mi"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s20",
      "text": "Mi madre está jubilada.",
      "de": "Meine Mutter ist in Rente.",
      "words": [
        "madre",
        "jubilado",
        "mi"
      ]
    },
    {
      "id": "s21",
      "text": "Mis papás viven en el campo.",
      "de": "Meine Eltern wohnen auf dem Land.",
      "words": [
        "papas",
        "mi",
        "vivir"
      ],
      "grammar": [
        "posesivos"
      ]
    },
    {
      "id": "s22",
      "text": "Tengo dos hermanos y una hermana.",
      "de": "Ich habe zwei Brüder und eine Schwester.",
      "words": [
        "hermano",
        "hermana",
        "dos"
      ]
    },
    {
      "id": "s23",
      "text": "Mi hermano vive en Berlín.",
      "de": "Mein Bruder wohnt in Berlin.",
      "words": [
        "hermano",
        "mi",
        "vivir"
      ]
    },
    {
      "id": "s24",
      "text": "Ella es mi novia.",
      "de": "Sie ist meine Freundin.",
      "words": [
        "novio",
        "mi"
      ]
    },
    {
      "id": "s25",
      "text": "Es un amigo de la familia.",
      "de": "Er ist ein Freund der Familie.",
      "words": [
        "amigo",
        "familia"
      ]
    },
    {
      "id": "s26",
      "text": "Mi abuelo tiene noventa años.",
      "de": "Mein Grossvater ist neunzig Jahre alt.",
      "words": [
        "abuelo",
        "ano",
        "mi"
      ]
    },
    {
      "id": "s27",
      "text": "Es mi nieto.",
      "de": "Das ist mein Enkel.",
      "words": [
        "nieto",
        "mi"
      ]
    },
    {
      "id": "s28",
      "text": "Los chicos están en la escuela.",
      "de": "Die Kinder sind in der Schule.",
      "words": [
        "chicos",
        "estar"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s29",
      "text": "Hace un año que estudio español.",
      "de": "Ich lerne seit einem Jahr Spanisch.",
      "words": [
        "ano",
        "estudiar",
        "espanol"
      ]
    },
    {
      "id": "s30",
      "text": "¿Cómo es tu nombre?",
      "de": "Wie ist dein Name?",
      "words": [
        "nombre",
        "tu",
        "como"
      ],
      "grammar": [
        "posesivos"
      ]
    },
    {
      "id": "s31",
      "text": "¿A qué te dedicás?",
      "de": "Was machst du beruflich?",
      "words": [
        "que"
      ],
      "grammar": [
        "voseo"
      ]
    },
    {
      "id": "s32",
      "text": "Trabajo en una empresa de software.",
      "de": "Ich arbeite in einer Softwarefirma.",
      "words": [
        "trabajar",
        "empresa"
      ]
    },
    {
      "id": "s33",
      "text": "Soy informático.",
      "de": "Ich bin Informatiker.",
      "words": [
        "informatico",
        "ser"
      ],
      "grammar": [
        "ser_estar"
      ]
    },
    {
      "id": "s34",
      "text": "Mi trabajo es interesante.",
      "de": "Meine Arbeit ist interessant.",
      "words": [
        "trabajo",
        "mi"
      ],
      "grammar": [
        "posesivos"
      ]
    },
    {
      "id": "s35",
      "text": "Tengo mucho laburo esta semana.",
      "de": "Ich habe diese Woche viel Arbeit.",
      "words": [
        "laburo",
        "mucho"
      ]
    },
    {
      "id": "s36",
      "text": "Ella es profesora de inglés.",
      "de": "Sie ist Englischlehrerin.",
      "words": [
        "profesor",
        "ingles"
      ]
    },
    {
      "id": "s37",
      "text": "Estudio español para el viaje.",
      "de": "Ich lerne Spanisch für die Reise.",
      "words": [
        "estudiar",
        "espanol",
        "viaje"
      ]
    },
    {
